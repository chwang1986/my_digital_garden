---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import { readingTime } from '../utils/reading-time';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 1.25rem;
			}

			/* ===== 站点身份区（masthead） ===== */
			.masthead {
				padding: 5rem 0 3rem;
				border-bottom: 1px solid var(--border-color);
			}

			.kicker {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				font-weight: 500;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin: 0 0 1.4rem;
			}

			.statement {
				font-size: 2.6rem;
				font-weight: 600;
				line-height: 1.18;
				letter-spacing: -0.02em;
				margin: 0 0 1.3rem;
				color: var(--text-main);
				max-width: 18ch;
			}

			.lede {
				font-size: 1.15rem;
				line-height: 1.75;
				color: var(--text-secondary);
				margin: 0;
				max-width: 34rem;
			}

			/* ===== 精选首篇 ===== */
			.featured {
				padding: 3rem 0 1rem;
			}

			.featured-link {
				display: flex;
				gap: 2rem;
				align-items: stretch;
				text-decoration: none;
				color: var(--text-main);
				border-radius: 20px;
				padding: 1.25rem;
				border: 1px solid transparent;
				transition:
					background 0.25s ease,
					border-color 0.25s ease;
			}

			.featured-link:hover {
				background: color-mix(in srgb, var(--primary-soft) 12%, transparent);
				border-color: color-mix(in srgb, var(--primary-color) 22%, transparent);
			}

			.featured-thumb {
				width: 300px;
				flex-shrink: 0;
				border-radius: 14px;
				overflow: hidden;
				background: color-mix(in srgb, var(--primary-soft) 28%, var(--background-body));
			}

			.featured-thumb :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.4s ease;
			}

			.featured-link:hover .featured-thumb :global(img) {
				transform: scale(1.04);
			}

			.featured-body {
				flex: 1;
				min-width: 0;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.featured-tag {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin: 0 0 0.9rem;
			}

			.featured-title {
				font-size: 1.7rem;
				font-weight: 700;
				line-height: 1.3;
				margin: 0 0 0.7rem;
				color: var(--text-main);
			}

			.featured-excerpt {
				font-size: 1rem;
				line-height: 1.65;
				color: var(--text-secondary);
				margin: 0 0 1rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.featured-date {
				margin-top: auto;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--text-secondary);
			}

			.featured-date .dot {
				margin: 0 0.45rem;
				opacity: 0.6;
			}

			/* ===== 其余列表 ===== */
			.recent-posts {
				padding: 2.5rem 0 1rem;
			}

			.recent-posts-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.2rem;
			}

			.recent-posts-head h2 {
				font-size: 0.82rem;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--text-secondary);
				margin: 0;
			}

			.recent-posts-head .view-all {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--primary-color);
				text-decoration: none;
			}

			.recent-posts-head .view-all:hover {
				color: var(--primary-strong);
			}

			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				border-top: 1px solid var(--border-color);
			}

			.post-item {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1.5rem;
				padding: 1.1rem 0.25rem;
				border-bottom: 1px solid var(--border-color);
				text-decoration: none;
				color: var(--text-main);
				transition:
					color 0.2s ease,
					padding 0.2s ease;
			}

			.post-item:hover {
				color: var(--primary-color);
				padding-left: 0.6rem;
			}

			.post-title {
				font-size: 1.15rem;
				font-weight: 600;
				line-height: 1.4;
			}

			.post-item:hover .post-title {
				color: var(--primary-color);
			}

			.post-meta {
				flex-shrink: 0;
				font-size: 0.85rem;
				color: var(--text-secondary);
				font-family: var(--font-mono);
			}

			@media (max-width: 720px) {
				.masthead {
					padding: 3.5rem 0 2.5rem;
				}
				.statement {
					font-size: 2rem;
				}
				.featured {
					padding: 2.5rem 0 0.5rem;
				}
				.featured-link {
					flex-direction: column;
					gap: 1.1rem;
					padding: 0.5rem;
				}
				.featured-thumb {
					width: 100%;
					height: 200px;
				}
				.featured-title {
					font-size: 1.4rem;
				}
			}

			@media (max-width: 480px) {
				.statement {
					font-size: 1.7rem;
				}
				.post-item {
					flex-direction: column;
					gap: 0.3rem;
					padding: 1rem 0.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="masthead">
				<p class="kicker">Wang's Notes</p>
				<h1 class="statement">把构建的过程，写成可追溯的笔记。</h1>
				<p class="lede">
					这里收录关于效率、系统与软件构建的随笔。每一篇都来自真实的工程实践，并记录它一路长成的轨迹。
				</p>
			</section>

			{
				featured && (
					<section class="featured">
						<a class="featured-link" href={`/blog/${featured.id}/`}>
							<div class="featured-thumb">
								{featured.data.heroImage && (
									<Image src={featured.data.heroImage} alt="" width={600} height={400} />
								)}
							</div>
							<div class="featured-body">
								<p class="featured-tag">最新发布</p>
								<h2 class="featured-title">{featured.data.title}</h2>
								{featured.data.description && (
									<p class="featured-excerpt">{featured.data.description}</p>
								)}
								<span class="featured-date">
									<FormattedDate date={featured.data.pubDate} />
									<span class="dot">·</span>
									{readingTime(featured.body)}
								</span>
							</div>
						</a>
					</section>
				)
			}

			<section class="recent-posts">
				<div class="recent-posts-head">
					<h2>全部随笔</h2>
					<a class="view-all" href="/blog">查看归档 →</a>
				</div>
				<ul class="post-list">
					{
						rest.map((post) => (
							<li>
								<a class="post-item" href={`/blog/${post.id}/`}>
									<span class="post-title">{post.data.title}</span>
									<span class="post-meta">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
