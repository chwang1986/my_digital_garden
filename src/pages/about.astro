---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 4rem 1.25rem 1rem;
			}

			.hero {
				padding-bottom: 2.5rem;
				margin-bottom: 3rem;
				border-bottom: 1px solid var(--border-color);
			}

			.about-title {
				font-size: 2.6rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				line-height: 1.15;
				margin: 0 0 1.1rem;
				color: var(--text-main);
			}

			.about-title .accent {
				color: var(--primary-color);
			}

			.about-intro {
				font-size: 1.1rem;
				line-height: 1.8;
				color: var(--text-secondary);
				margin: 0;
				max-width: 38rem;
			}

			.prose {
				max-width: var(--content-width);
				margin: 0 auto;
			}

			.section-title {
				font-size: 1.3rem;
				font-weight: 700;
				color: var(--text-main);
				margin: 2.5rem 0 1rem;
			}

			.section-title:first-child {
				margin-top: 0;
			}

			.lead {
				font-size: 1.05rem;
				line-height: 1.75;
				color: var(--text-secondary);
				margin: 0 0 1.5rem;
			}

			.topics {
				list-style: none;
				padding: 0;
				margin: 0 0 1.5rem;
			}

			.topics li {
				display: flex;
				gap: 0.75rem;
				align-items: baseline;
				padding: 0.55rem 0;
				border-bottom: 1px solid var(--border-color);
				color: var(--text-secondary);
			}

			.topics li:last-child {
				border-bottom: none;
			}

			.topics .t-title {
				color: var(--text-main);
				font-weight: 600;
				flex-shrink: 0;
				min-width: 6.5rem;
			}

			.stack {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 0 0 1.5rem;
			}

			.stack span {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--text-secondary);
				padding: 0.3rem 0.7rem;
				border: 1px solid var(--border-color);
				border-radius: 6px;
			}

			@media (max-width: 600px) {
				main {
					padding-top: 2.5rem;
				}
				.about-title {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1 class="about-title">关于 <span class="accent">Wang's Notes</span></h1>
				<p class="about-intro">
					我是一名工程师，习惯把做过的事、踩过的坑和想通的逻辑写下来。这里是我存放这些文字的地方——一个用
					Astro 构建、内容全部进 Git 的数字花园。
				</p>
			</section>

			<article class="prose">
				<h2 class="section-title">我写什么</h2>
				<p class="lead">
					这里既有工程实践，也有本地 AI 的折腾，还有一些读史与思考：
				</p>
				<ul class="topics">
					<li><span class="t-title">工程实践</span><span>博客平台怎么搭、效率系统，以及如何用 Git 把写作与决策管理起来。</span></li>
					<li><span class="t-title">本地 AI</span><span>用 Ollama 在本地跑大模型，从安装、调用到实战，一步步来。</span></li>
					<li><span class="t-title">思考与历史</span><span>读史的一点议论，以及个人的逻辑与系统思考。</span></li>
				</ul>

				<h2 class="section-title">技术栈</h2>
				<p class="lead">本站是一套极简静态工程：</p>
				<div class="stack">
					<span>Astro</span>
					<span>TypeScript</span>
					<span>Markdown / MDX</span>
					<span>GitHub</span>
					<span>Vercel</span>
					<span>Push 即部署</span>
				</div>

			<h2 class="section-title">如何找到我</h2>
			<p class="lead">如果你也在折腾笔记、博客或构建工具，欢迎顺着文章里的思路一起聊。</p>
		</article>
		</main>
		<Footer />
	</body>
</html>
