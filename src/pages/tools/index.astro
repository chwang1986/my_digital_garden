---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// 按常见使用频率从高到低排序（开发/调试最常碰的靠前）
const tools = [
	{ id: 'json', name: 'JSON 格式化', desc: '格式化、压缩、校验 JSON' },
	{ id: 'base64', name: 'Base64 编解码', desc: '文本与 Base64 互转，UTF-8 安全' },
	{ id: 'timestamp', name: '时间戳', desc: '当前时间戳，以及时间戳与日期互转' },
	{ id: 'counter', name: '文本统计', desc: '字数、词数、行数、预计阅读时长' },
	{ id: 'password', name: '密码生成', desc: '可配置长度与字符集，一键复制' },
	{ id: 'color', name: '颜色转换', desc: 'HEX / RGB / HSL 互转，实时预览' },
	{ id: 'convert', name: '单位换算', desc: '长度 / 重量 / 温度常用单位' },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`小工具 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}

			.page-head h1 {
				font-size: 2.2rem;
				margin: 0 0 0.5rem;
			}

			.page-head p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.05rem;
			}

			/* 工具跳转锚点栏 */
			.tool-nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 1.6rem 0 0.5rem;
				position: sticky;
				top: 4.2rem;
				z-index: 10;
				padding: 0.6rem 0.7rem;
				background: color-mix(in srgb, var(--surface) 88%, transparent);
				backdrop-filter: blur(8px);
				border: 1px solid var(--border-color);
				border-radius: 12px;
			}

			.tool-nav a {
				font-family: var(--font-mono);
				font-size: 0.82rem;
				color: var(--text-secondary);
				text-decoration: none;
				padding: 0.35rem 0.7rem;
				border-radius: 8px;
				border: 1px solid transparent;
				transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
			}

			.tool-nav a:hover {
				color: var(--primary-color);
				background: var(--code-bg);
				border-color: color-mix(in srgb, var(--primary-color) 35%, transparent);
			}

			.tool-grid {
				display: flex;
				flex-direction: column;
				gap: 2.2rem;
				margin: 1.5rem 0 1rem;
			}

			/* 奇偶卡片交替底色，强化区块分割 */
			.card {
				position: relative;
				border: 1px solid var(--border-color);
				border-radius: 12px;
				background: var(--surface);
				padding: 1.3rem 1.4rem 1.1rem;
				scroll-margin-top: 8rem;
				border-left: 3px solid var(--primary-color);
			}

			.tool-grid .card:nth-child(even) {
				background: color-mix(in srgb, var(--primary-soft) 14%, var(--surface));
				border-left-color: var(--primary-2);
			}

			/* 每个工具卡片底部的回到顶端 */
			.card-foot {
				display: flex;
				justify-content: flex-end;
				margin-top: 0.4rem;
			}

			.to-top {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--text-secondary);
				background: transparent;
				border: 1px solid var(--border-color);
				border-radius: 999px;
				padding: 0.3rem 0.8rem;
				cursor: pointer;
				transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
			}

			.to-top:hover {
				color: var(--primary-color);
				border-color: color-mix(in srgb, var(--primary-color) 40%, transparent);
				background: var(--code-bg);
			}

			.card-head {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				margin-bottom: 1.1rem;
				padding-bottom: 0.8rem;
				border-bottom: 1px solid var(--border-color);
			}

			.card-no {
				flex: none;
				font-family: var(--font-mono);
				font-size: 0.82rem;
				font-weight: 700;
				color: var(--on-accent);
				background: linear-gradient(120deg, var(--primary-color), var(--primary-2));
				border-radius: 7px;
				padding: 0.22rem 0.5rem;
				letter-spacing: 0.02em;
			}

			.card-head h2 {
				font-size: 1.1rem;
				margin: 0;
				font-weight: 700;
				flex: 1;
			}

			.card-head .desc {
				font-size: 0.78rem;
				color: var(--text-secondary);
				font-family: var(--font-mono);
			}

			/* 通用输入 */
			textarea,
			input[type='text'],
			input[type='number'] {
				width: 100%;
				font-family: var(--font-mono);
				font-size: 0.9rem;
				color: var(--text-main);
				background: var(--code-bg);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				padding: 0.6rem 0.7rem;
				resize: vertical;
			}

			textarea:focus,
			input:focus {
				outline: none;
				border-color: var(--primary-color);
				box-shadow: 0 0 0 3px var(--glow);
			}

			label {
				display: block;
				font-size: 0.8rem;
				color: var(--text-secondary);
				margin: 0.8rem 0 0.35rem;
			}

			.stat-row {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.6rem;
				margin-top: 0.8rem;
			}

			.stat {
				text-align: center;
				background: var(--code-bg);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				padding: 0.6rem 0.3rem;
			}

			.stat b {
				display: block;
				font-size: 1.3rem;
				color: var(--primary-color);
				font-family: var(--font-mono);
			}

			.stat span {
				font-size: 0.72rem;
				color: var(--text-secondary);
			}

			/* 颜色工具 */
			.color-preview {
				height: 56px;
				border-radius: 8px;
				border: 1px solid var(--border-color);
				margin: 0.8rem 0 0.4rem;
				background: #0ea5e9;
				transition: background 0.15s ease;
			}

			/* 时间戳 */
			.ts-now {
				font-family: var(--font-mono);
				font-size: 1.4rem;
				color: var(--primary-color);
				margin: 0.4rem 0;
			}

			/* 密码 */
			.pw-out {
				font-size: 1rem;
				letter-spacing: 0.02em;
				word-break: break-all;
			}

			.controls {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.8rem 1.1rem;
				margin: 0.6rem 0;
			}

			.controls label {
				margin: 0;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.82rem;
				color: var(--text-main);
			}

			.controls input[type='number'] {
				width: 64px;
			}

			.controls input[type='checkbox'] {
				width: 15px;
				height: 15px;
				accent-color: var(--primary-color);
			}

			.controls select {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--text-main);
				background: var(--code-bg);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				padding: 0.45rem 0.55rem;
			}

			.controls select:focus {
				outline: none;
				border-color: var(--primary-color);
				box-shadow: 0 0 0 3px var(--glow);
			}

			.msg-err {
				color: #ef4444 !important;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-family: var(--font-body);
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--on-accent);
				background: linear-gradient(100deg, var(--primary-color), var(--primary-2));
				border: none;
				border-radius: 8px;
				padding: 0.55rem 0.95rem;
				cursor: pointer;
				box-shadow: var(--glow-sm);
				transition:
					filter 0.2s ease,
					transform 0.15s ease;
			}

			.btn:hover {
				filter: brightness(1.06);
			}

			.btn:active {
				transform: scale(0.97);
			}

			.btn.ghost {
				color: var(--primary-color);
				background: transparent;
				border: 1px solid color-mix(in srgb, var(--primary-color) 45%, transparent);
				box-shadow: none;
			}

			.hint {
				font-size: 0.78rem;
				color: var(--text-secondary);
				margin: 0.5rem 0 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>小工具</h1>
				<p>几个纯前端、离线可用的小工具，打开就能用。</p>
			</header>

			<nav class="tool-nav" aria-label="工具快速跳转">
				{
					tools.map((t) => (
						<a href={`#${t.id}`}>{t.name}</a>
					))
				}
			</nav>

		<section class="tool-grid">
			<!-- JSON 格式化 -->
			<article class="card" id="json">
				<div class="card-head">
					<span class="card-no">01</span>
					<h2>JSON 格式化</h2>
					<span class="desc">格式化 / 压缩 / 校验</span>
				</div>
				<textarea id="json-in" rows="5" placeholder="粘贴 JSON…"></textarea>
				<div class="controls">
					<button class="btn" id="json-fmt">格式化</button>
					<button class="btn ghost" id="json-min">压缩</button>
					<button class="btn ghost" id="json-copy">复制</button>
				</div>
				<textarea id="json-out" rows="5" readonly placeholder="结果将显示在这里"></textarea>
				<p class="hint" id="json-msg">支持格式化（缩进 2 空格）与压缩，自动校验。</p>
				<div class="card-foot"><button class="to-top" data-top>↑ 回到顶端</button></div>
			</article>

			<!-- Base64 编解码 -->
			<article class="card" id="base64">
				<div class="card-head">
					<span class="card-no">02</span>
					<h2>Base64 编解码</h2>
					<span class="desc">UTF-8 安全</span>
				</div>
				<textarea id="b64-in" rows="3" placeholder="输入文本或 Base64…"></textarea>
				<div class="controls">
					<button class="btn" id="b64-enc">编码 →</button>
					<button class="btn ghost" id="b64-dec">← 解码</button>
					<button class="btn ghost" id="b64-copy">复制</button>
				</div>
				<textarea id="b64-out" rows="3" readonly placeholder="结果将显示在这里"></textarea>
				<p class="hint" id="b64-msg">中文等 Unicode 内容也能正确编解码。</p>
				<div class="card-foot"><button class="to-top" data-top>↑ 回到顶端</button></div>
			</article>

			<!-- 时间戳 -->
			<article class="card" id="timestamp">
				<div class="card-head">
					<span class="card-no">03</span>
					<h2>时间戳</h2>
					<span class="desc">Unix 秒 / 毫秒</span>
				</div>
				<p class="ts-now" id="ts-now">—</p>
				<label for="ts-input">时间戳 → 日期（支持秒或毫秒）</label>
				<input type="text" id="ts-input" placeholder="如 1700000000" spellcheck="false" />
				<p class="hint" id="ts-result">—</p>
				<label for="ts-date">日期 → 时间戳</label>
				<input type="text" id="ts-date" placeholder="如 2026-08-23 18:00:00" spellcheck="false" />
				<p class="hint" id="ts-result2">—</p>
				<div class="card-foot"><button class="to-top" data-top>↑ 回到顶端</button></div>
			</article>

			<!-- 文本统计 -->
			<article class="card" id="counter">
				<div class="card-head">
					<span class="card-no">04</span>
					<h2>文本统计</h2>
					<span class="desc">字数 / 词数 / 行数</span>
				</div>
				<textarea id="counter-text" rows="4" placeholder="粘贴或输入文本…"></textarea>
				<div class="stat-row">
					<div class="stat"><b id="st-chars">0</b><span>字符</span></div>
					<div class="stat"><b id="st-chars-no-space">0</b><span>去空格</span></div>
					<div class="stat"><b id="st-words">0</b><span>词数</span></div>
					<div class="stat"><b id="st-lines">0</b><span>行数</span></div>
				</div>
				<p class="hint" id="st-read">预计阅读：0 分钟</p>
				<div class="card-foot"><button class="to-top" data-top>↑ 回到顶端</button></div>
			</article>

			<!-- 密码生成 -->
			<article class="card" id="password">
				<div class="card-head">
					<span class="card-no">05</span>
					<h2>密码生成</h2>
					<span class="desc">本地生成</span>
				</div>
				<input type="text" id="pw-out" class="pw-out" readonly />
				<div class="controls">
					<label>长度 <input type="number" id="pw-len" value="16" min="4" max="64" /></label>
					<label><input type="checkbox" id="pw-lower" checked /> 小写</label>
					<label><input type="checkbox" id="pw-upper" checked /> 大写</label>
					<label><input type="checkbox" id="pw-num" checked /> 数字</label>
					<label><input type="checkbox" id="pw-sym" /> 符号</label>
				</div>
				<div class="controls">
					<button class="btn" id="pw-gen">生成</button>
					<button class="btn ghost" id="pw-copy">复制</button>
				</div>
				<div class="card-foot"><button class="to-top" data-top>↑ 回到顶端</button></div>
			</article>

			<!-- 颜色转换 -->
			<article class="card" id="color">
				<div class="card-head">
					<span class="card-no">06</span>
					<h2>颜色转换</h2>
					<span class="desc">HEX / RGB / HSL</span>
				</div>
				<label for="color-hex">HEX</label>
				<input type="text" id="color-hex" value="#0ea5e9" spellcheck="false" />
				<div class="color-preview" id="color-preview"></div>
				<label for="color-rgb">RGB</label>
				<input type="text" id="color-rgb" readonly />
				<label for="color-hsl">HSL</label>
				<input type="text" id="color-hsl" readonly />
				<div class="card-foot"><button class="to-top" data-top>↑ 回到顶端</button></div>
			</article>

			<!-- 单位换算 -->
			<article class="card" id="convert">
				<div class="card-head">
					<span class="card-no">07</span>
					<h2>单位换算</h2>
					<span class="desc">长度 / 重量 / 温度</span>
				</div>
				<div class="controls">
					<label>类别
						<select id="cv-cat">
							<option value="length">长度</option>
							<option value="weight">重量</option>
							<option value="temp">温度</option>
						</select>
					</label>
				</div>
				<div class="controls">
					<input type="number" id="cv-from" value="1" step="any" style="width:90px" />
					<select id="cv-unit-a"></select>
					<span style="color:var(--text-secondary)">→</span>
					<input type="text" id="cv-to" readonly style="width:90px" />
					<select id="cv-unit-b"></select>
				</div>
				<p class="hint" id="cv-msg">输入左侧数值即时换算。</p>
				<div class="card-foot"><button class="to-top" data-top>↑ 回到顶端</button></div>
			</article>
		</section>
		</main>
		<Footer />

		<script>
			// ===== 文本统计 =====
			const cText = document.getElementById('counter-text') as HTMLTextAreaElement | null;
			const st = {
				chars: document.getElementById('st-chars'),
				noSpace: document.getElementById('st-chars-no-space'),
				words: document.getElementById('st-words'),
				lines: document.getElementById('st-lines'),
				read: document.getElementById('st-read'),
			};
			cText?.addEventListener('input', () => {
				const v = cText.value;
				const chars = v.length;
				const noSpace = v.replace(/\s/g, '').length;
				const words = (v.trim().match(/[\u4e00-\u9fa5]|[A-Za-z0-9]+/g) || []).length;
				const lines = v === '' ? 0 : v.split('\n').length;
				if (st.chars) st.chars.textContent = String(chars);
				if (st.noSpace) st.noSpace.textContent = String(noSpace);
				if (st.words) st.words.textContent = String(words);
				if (st.lines) st.lines.textContent = String(lines);
				if (st.read) {
					const min = Math.max(1, Math.ceil(words / 300));
					st.read.textContent = `预计阅读：${words === 0 ? 0 : min} 分钟`;
				}
			});

			// ===== 颜色转换 =====
			const hexIn = document.getElementById('color-hex') as HTMLInputElement | null;
			const rgbIn = document.getElementById('color-rgb') as HTMLInputElement | null;
			const hslIn = document.getElementById('color-hsl') as HTMLInputElement | null;
			const preview = document.getElementById('color-preview');
			const clamp = (n: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, n));

			const hexToRgb = (hex: string) => {
				const m = hex.replace('#', '').match(/^([0-9a-f]{6})$/i);
				if (!m) return null;
				const n = parseInt(m[1], 16);
				return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
			};
			const rgbToHsl = (r: number, g: number, b: number) => {
				r /= 255; g /= 255; b /= 255;
				const max = Math.max(r, g, b), min = Math.min(r, g, b);
				let h = 0, s = 0;
				const l = (max + min) / 2;
				const d = max - min;
				if (d !== 0) {
					s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
					switch (max) {
						case r: h = (g - b) / d + (g < b ? 6 : 0); break;
						case g: h = (b - r) / d + 2; break;
						default: h = (r - g) / d + 4;
					}
					h /= 6;
				}
				return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
			};
			const updateColor = (hex: string) => {
				const rgb = hexToRgb(hex);
				if (!rgb) return;
				if (rgbIn) rgbIn.value = `rgb(${rgb.r}, ${rgb.g}, ${rgb.b})`;
				const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
				if (hslIn) hslIn.value = `hsl(${hsl.h}, ${hsl.s}%, ${hsl.l}%)`;
				if (preview) preview.style.background = hex;
			};
			hexIn?.addEventListener('input', () => updateColor(hexIn.value.trim()));
			updateColor(hexIn?.value || '#0ea5e9');

			// ===== 时间戳 =====
			const tsNow = document.getElementById('ts-now');
			const tsInput = document.getElementById('ts-input') as HTMLInputElement | null;
			const tsResult = document.getElementById('ts-result');
			const tsDate = document.getElementById('ts-date') as HTMLInputElement | null;
			const tsResult2 = document.getElementById('ts-result2');
			const pad = (n: number) => String(n).padStart(2, '0');
			const fmt = (d: Date) =>
				`${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
			const tickNow = () => {
				const n = Math.floor(Date.now() / 1000);
				if (tsNow) tsNow.textContent = `${n} （毫秒 ${n * 1000}）`;
			};
			tickNow();
			window.setInterval(tickNow, 1000);
			tsInput?.addEventListener('input', () => {
				const v = tsInput.value.trim();
				const n = Number(v);
				if (!v || !Number.isFinite(n)) {
					if (tsResult) tsResult.textContent = '—';
					return;
				}
				const ms = v.length >= 13 ? n : n * 1000;
				if (tsResult) tsResult.textContent = fmt(new Date(ms));
			});
			tsDate?.addEventListener('input', () => {
				const v = tsDate.value.trim();
				const d = new Date(v.replace(' ', 'T'));
				if (isNaN(d.getTime())) {
					if (tsResult2) tsResult2.textContent = '—';
					return;
				}
				const s = Math.floor(d.getTime() / 1000);
				if (tsResult2) tsResult2.textContent = `秒 ${s} · 毫秒 ${s * 1000}`;
			});

			// ===== 密码生成 =====
			const pwOut = document.getElementById('pw-out') as HTMLInputElement | null;
			const pwLen = document.getElementById('pw-len') as HTMLInputElement | null;
			const sets = {
				lower: 'abcdefghijkmnpqrstuvwxyz',
				upper: 'ABCDEFGHJKLMNPQRSTUVWXYZ',
				num: '23456789',
				sym: '!@#$%^&*-_=+',
			};
			const genPw = () => {
				const len = clamp(parseInt(pwLen?.value || '16', 10) || 16, 4, 64);
				let pool = '';
				const picks: string[] = [];
				(['lower', 'upper', 'num', 'sym'] as const).forEach((k) => {
					const el = document.getElementById('pw-' + k) as HTMLInputElement | null;
					if (el?.checked) {
						pool += sets[k];
						picks.push(sets[k][Math.floor(Math.random() * sets[k].length)]);
					}
				});
				if (!pool) {
					if (pwOut) pwOut.value = '请至少选择一种字符';
					return;
				}
				let out = picks.join('');
				while (out.length < len) out += pool[Math.floor(Math.random() * pool.length)];
				out = out.slice(0, len);
				if (pwOut) pwOut.value = out;
			};
			document.getElementById('pw-gen')?.addEventListener('click', genPw);
			document.getElementById('pw-copy')?.addEventListener('click', async () => {
				if (pwOut?.value) {
					try {
						await navigator.clipboard.writeText(pwOut.value);
					} catch {}
				}
			});
			genPw();

			// ===== JSON 格式化 =====
			const jsonIn = document.getElementById('json-in') as HTMLTextAreaElement | null;
			const jsonOut = document.getElementById('json-out') as HTMLTextAreaElement | null;
			const jsonMsg = document.getElementById('json-msg');
			const utf8 = (s: string) => new TextEncoder().encode(s);
			const setJsonMsg = (t: string, err = false) => {
				if (jsonMsg) {
					jsonMsg.textContent = t;
					jsonMsg.classList.toggle('msg-err', err);
				}
			};
			const parseJson = (raw: string) => {
				try {
					return { ok: true, val: JSON.parse(raw) as unknown };
				} catch (e) {
					return { ok: false, err: (e as Error).message };
				}
			};
			const doJsonFmt = () => {
				if (!jsonIn || !jsonOut) return;
				const r = parseJson(jsonIn.value.trim());
				if (!r.ok) { jsonOut.value = ''; setJsonMsg('解析失败：' + r.err, true); return; }
				jsonOut.value = JSON.stringify(r.val, null, 2);
				setJsonMsg('已格式化（缩进 2 空格）。');
			};
			const doJsonMin = () => {
				if (!jsonIn || !jsonOut) return;
				const r = parseJson(jsonIn.value.trim());
				if (!r.ok) { jsonOut.value = ''; setJsonMsg('解析失败：' + r.err, true); return; }
				jsonOut.value = JSON.stringify(r.val);
				setJsonMsg('已压缩为一行。');
			};
			document.getElementById('json-fmt')?.addEventListener('click', doJsonFmt);
			document.getElementById('json-min')?.addEventListener('click', doJsonMin);
			document.getElementById('json-copy')?.addEventListener('click', async () => {
				if (jsonOut?.value) { try { await navigator.clipboard.writeText(jsonOut.value); setJsonMsg('已复制到剪贴板。'); } catch {} }
			});

			// ===== Base64 编解码 =====
			const b64In = document.getElementById('b64-in') as HTMLTextAreaElement | null;
			const b64Out = document.getElementById('b64-out') as HTMLTextAreaElement | null;
			const b64Msg = document.getElementById('b64-msg');
			const setB64Msg = (t: string, err = false) => {
				if (b64Msg) { b64Msg.textContent = t; b64Msg.classList.toggle('msg-err', err); }
			};
			const bytesToB64 = (bytes: Uint8Array) => {
				let bin = '';
				bytes.forEach((b) => (bin += String.fromCharCode(b)));
				return btoa(bin);
			};
			const b64ToBytes = (s: string) => {
				const bin = atob(s);
				const out = new Uint8Array(bin.length);
				for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
				return out;
			};
			document.getElementById('b64-enc')?.addEventListener('click', () => {
				if (!b64In || !b64Out) return;
				try {
					b64Out.value = bytesToB64(utf8(b64In.value));
					setB64Msg('已编码为 Base64。');
				} catch { b64Out.value = ''; setB64Msg('编码失败。', true); }
			});
			document.getElementById('b64-dec')?.addEventListener('click', () => {
				if (!b64In || !b64Out) return;
				try {
					b64Out.value = new TextDecoder().decode(b64ToBytes(b64In.value.trim()));
					setB64Msg('已解码。');
				} catch { b64Out.value = ''; setB64Msg('不是合法的 Base64。', true); }
			});
			document.getElementById('b64-copy')?.addEventListener('click', async () => {
				if (b64Out?.value) { try { await navigator.clipboard.writeText(b64Out.value); setB64Msg('已复制到剪贴板。'); } catch {} }
			});

			// ===== 单位换算 =====
			const cvData: Record<string, Record<string, number>> = {
				length: { m: 1, cm: 0.01, mm: 0.001, km: 1000, in: 0.0254, ft: 0.3048, mi: 1609.344 },
				weight: { kg: 1, g: 0.001, t: 1000, lb: 0.45359237, oz: 0.028349523125 },
				temp: { C: 1, F: 1, K: 1 },
			};
			const cvCat = document.getElementById('cv-cat') as HTMLSelectElement | null;
			const cvFrom = document.getElementById('cv-from') as HTMLInputElement | null;
			const cvTo = document.getElementById('cv-to') as HTMLInputElement | null;
			const cvA = document.getElementById('cv-unit-a') as HTMLSelectElement | null;
			const cvB = document.getElementById('cv-unit-b') as HTMLSelectElement | null;
			const cvMsg = document.getElementById('cv-msg');
			const fillUnits = (cat: string) => {
				const units = Object.keys(cvData[cat]);
				if (cvA && cvB) {
					cvA.innerHTML = units.map((u) => `<option value="${u}">${u}</option>`).join('');
					cvB.innerHTML = units.map((u) => `<option value="${u}">${u}</option>`).join('');
					// 默认选两个不同的单位
					if (units.length > 1) cvB.selectedIndex = 1;
				}
			};
			const convert = () => {
				if (!cvCat || !cvFrom || !cvTo || !cvA || !cvB || !cvMsg) return;
				const cat = cvCat.value;
				const a = cvA.value, b = cvB.value;
				const v = parseFloat(cvFrom.value);
				if (!Number.isFinite(v)) { cvTo.value = ''; return; }
				let res: number;
				if (cat === 'temp') {
					// 先转成摄氏度
					let c: number;
					if (a === 'C') c = v;
					else if (a === 'F') c = (v - 32) * 5 / 9;
					else c = v - 273.15;
					if (b === 'C') res = c;
					else if (b === 'F') res = c * 9 / 5 + 32;
					else res = c + 273.15;
				} else {
					res = (v * cvData[cat][a]) / cvData[cat][b];
				}
				cvTo.value = String(Math.round(res * 1e6) / 1e6);
			};
			cvCat?.addEventListener('change', () => { fillUnits(cvCat!.value); convert(); });
			cvFrom?.addEventListener('input', convert);
			cvA?.addEventListener('change', convert);
			cvB?.addEventListener('change', convert);
			if (cvCat) { fillUnits(cvCat.value); convert(); }

			// ===== 回到顶端 =====
			document.querySelectorAll<HTMLButtonElement>('[data-top]').forEach((btn) => {
				btn.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
			});
		</script>
	</body>
</html>
