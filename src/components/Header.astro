---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_BRAND } from '../consts';
---

<header>
	<nav>
		<!-- 站点标题 / Logo -->
		<h2><a href="/">{SITE_BRAND}</a></h2>

		<!-- 导航菜单与主题切换 -->
		<div class="nav-links">
			<div class="internal-links">
				<HeaderLink href="/">首页</HeaderLink>
				<HeaderLink href="/blog">文章</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
			</div>
			<!-- 暗黑模式切换按钮 -->
			<ThemeToggle />
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 1.1rem 1.25rem;
		border-bottom: 1px solid var(--border-color);
		background-color: color-mix(in srgb, var(--bg-color) 85%, transparent);
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
		position: sticky;
		top: 0;
		z-index: 10;
		backdrop-filter: saturate(180%) blur(8px);
		-webkit-backdrop-filter: saturate(180%) blur(8px);
	}

	nav {
		max-width: var(--wide-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	h2 {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	h2 a {
		color: var(--text-color);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	h2 a:hover {
		color: var(--accent-color);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	/* HeaderLink 组件在导航栏中的外观 */
	.internal-links :global(a) {
		padding: 0.25rem 0;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		border-bottom: 2px solid transparent;
		transition: all 0.2s ease;
	}

	.internal-links :global(a:hover) {
		color: var(--text-color);
	}

	/* 当前页面高亮样式 */
	.internal-links :global(a.active) {
		color: var(--text-color);
		border-bottom-color: var(--accent-color);
		font-weight: 600;
	}

	@media (max-width: 600px) {
		header {
			padding: 0.9rem 1rem;
		}

		h2 {
			font-size: 1.05rem;
		}

		.nav-links {
			gap: 1rem;
		}

		.internal-links {
			gap: 0.85rem;
		}

		.internal-links :global(a) {
			font-size: 0.9rem;
		}
	}
</style>
