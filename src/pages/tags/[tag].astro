---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostGrid from '../../components/PostGrid.astro';
import { sortPosts } from '../../utils/sort-posts';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const set = new Set<string>();
	for (const p of posts) for (const t of p.data.tags) set.add(t);
	return [...set].map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: sortPosts(posts.filter((p) => p.data.tags.includes(tag))),
		},
	}));
}

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${tag} - ${SITE_TITLE}`} description={`标签「${tag}」下的文章`} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}
			/* 卡片网格由 PostGrid 组件统一管理 */
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<a class="back" href="/tags">← 全部标签</a>
				<h1><span class="hash">#</span>{tag}</h1>
			</header>
			<PostGrid posts={posts} />
		</main>
		<Footer />
	</body>
</html>
