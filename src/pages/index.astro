---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 1.25rem;
			}

			.hero {
				padding: 4.5rem 0 3rem;
				border-bottom: 1px solid var(--border-color);
			}

			.eyebrow {
				font-size: 0.8rem;
				font-weight: 600;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin-bottom: 1rem;
			}

			.title {
				font-size: 3rem;
				font-weight: 800;
				margin: 0 0 1.1rem 0;
				color: var(--text-main);
				letter-spacing: -0.03em;
				line-height: 1.1;
			}

			.title .accent {
				color: var(--primary-color);
			}

			.intro-text {
				font-size: 1.15rem;
				line-height: 1.8;
				color: var(--text-secondary);
				max-width: 36rem;
				margin: 0;
			}

			.recent-posts {
				padding: 3rem 0 1rem;
			}

			.recent-posts h2 {
				font-size: 0.85rem;
				font-weight: 600;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-secondary);
				margin: 0 0 0.5rem;
			}

			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.post-item {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				padding: 1rem 0;
				border-bottom: 1px solid var(--border-color);
			}

			.post-item a {
				font-size: 1.15rem;
				font-weight: 500;
				color: var(--text-main);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.post-item a:hover {
				color: var(--primary-color);
			}

			.post-date {
				flex-shrink: 0;
				font-size: 0.85rem;
				color: var(--text-secondary);
				font-family: var(--font-mono);
			}

			.view-all {
				display: inline-block;
				margin-top: 1.75rem;
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--primary-color);
				text-decoration: none;
			}

			.view-all:hover {
				color: var(--primary-strong);
			}

			@media (max-width: 600px) {
				.hero {
					padding: 3rem 0 2rem;
				}
				.title {
					font-size: 2.25rem;
				}
				.post-item {
					flex-direction: column;
					gap: 0.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">数字花园 · Digital Garden</p>
				<h1 class="title">Wang's <span class="accent">Notes</span></h1>
				<p class="intro-text">
					这里记录技术实践、碎片化的逻辑思考，以及关于效率与系统的随笔。
				</p>
			</section>

			<section class="recent-posts">
				<h2>最新随笔 & 笔记</h2>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</li>
						))
					}
				</ul>
				<a class="view-all" href="/blog">查看全部文章 →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
