---
---

<button class="search-trigger" id="search-trigger" aria-label="搜索" type="button" title="搜索">
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
	</svg>
</button>

<div class="search-overlay" id="search-overlay" aria-hidden="true">
	<div class="search-dialog">
		<div class="search-bar">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
			</svg>
			<input type="text" id="search-input" placeholder="搜索文章..." autocomplete="off" />
			<kbd>Esc</kbd>
		</div>
		<div id="search-results" class="search-results">
			<p class="search-hint">输入关键词开始搜索</p>
		</div>
	</div>
</div>

<style>
	.search-trigger {
		background: none;
		border: none;
		cursor: pointer;
		color: var(--text-muted);
		padding: 0.2rem;
		border-radius: 6px;
		transition: color 0.2s ease;
		display: flex;
		align-items: center;
	}

	.search-trigger:hover { color: var(--text-color); }

	.search-overlay {
		position: fixed;
		inset: 0;
		z-index: 50;
		background: rgba(0, 0, 0, 0.45);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: 14vh;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.25s ease, visibility 0.25s ease;
	}

	.search-overlay.open {
		opacity: 1;
		visibility: visible;
	}

	.search-dialog {
		width: min(580px, 92vw);
		max-height: 70vh;
		background: var(--surface);
		border: 1px solid var(--border-color);
		border-radius: 18px;
		box-shadow: var(--shadow-md);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.search-bar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.8rem 1.1rem;
		border-bottom: 1px solid var(--border-color);
	}

	.search-bar svg { flex-shrink: 0; color: var(--text-secondary); }

	.search-bar input {
		flex: 1;
		border: none;
		outline: none;
		background: transparent;
		font-size: 1.05rem;
		font-family: var(--font-body);
		color: var(--text-main);
	}

	.search-bar input::placeholder { color: var(--text-secondary); }

	.search-bar kbd {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		padding: 0.15rem 0.4rem;
		border: 1px solid var(--border-color);
		border-radius: 4px;
		color: var(--text-secondary);
	}

	.search-results {
		overflow-y: auto;
		padding: 0.6rem;
		min-height: 60px;
	}

	.search-hint {
		text-align: center;
		color: var(--text-secondary);
		font-size: 0.9rem;
		padding: 1.5rem 0;
		margin: 0;
	}

	.search-results a {
		display: block;
		padding: 0.7rem 0.8rem;
		border-radius: 10px;
		text-decoration: none;
		color: var(--text-main);
		transition: background 0.15s ease;
	}

	.search-results a:hover { background: color-mix(in srgb, var(--primary-soft) 12%, transparent); }

	.search-results a .sr-title {
		display: block;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.4;
		margin-bottom: 0.2rem;
	}

	.search-results a .sr-meta {
		display: block;
		font-size: 0.78rem;
		color: var(--text-secondary);
		font-family: var(--font-mono);
	}
</style>

<script>
	async function initSearch() {
		const trigger = document.getElementById('search-trigger');
		const overlay = document.getElementById('search-overlay');
		const input = document.getElementById('search-input') as HTMLInputElement;
		const results = document.getElementById('search-results');

		if (!trigger || !overlay || !input || !results) return;

		let pagefind: any = null;
		try {
			pagefind = await new Function('return import("/pagefind/pagefind.js")')();
			await pagefind.options({ baseUrl: '/' });
		} catch {
			/* dev 模式：Pagefind 不可用，显示提示 */
		}

		function open() {
			overlay!.classList.add('open');
			overlay!.setAttribute('aria-hidden', 'false');
			setTimeout(() => input!.focus(), 100);
			if (!pagefind) {
				results!.innerHTML = '<p class="search-hint">搜索仅在生产环境可用<br><small>运行 <code>npm run build && npm run preview</code> 体验</small></p>';
			}
		}

		function close() {
			overlay!.classList.remove('open');
			overlay!.setAttribute('aria-hidden', 'true');
			input!.value = '';
			results!.innerHTML = pagefind ? '<p class="search-hint">输入关键词开始搜索</p>' : '';
		}

		trigger.addEventListener('click', open);
		overlay.addEventListener('click', (e) => {
			if (e.target === overlay) close();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && overlay.classList.contains('open')) close();
			if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); open(); }
		});

		if (!pagefind) return; /* dev 模式：不绑定输入事件 */

		let debounce: ReturnType<typeof setTimeout>;
		input.addEventListener('input', () => {
			clearTimeout(debounce);
			const query = input.value.trim();
			if (!query) {
				results.innerHTML = '<p class="search-hint">输入关键词开始搜索</p>';
				return;
			}
			results.innerHTML = '<p class="search-hint">搜索中...</p>';
			debounce = setTimeout(async () => {
				const search = await pagefind.search(query);
				if (!search.results.length) {
					results.innerHTML = '<p class="search-hint">没有找到相关文章</p>';
					return;
				}
				const html = (await Promise.all(
					search.results.slice(0, 8).map(async (r: any) => {
						const d = await r.data();
						return `<a href="${d.url}">
							<span class="sr-title">${d.meta.title}</span>
							<span class="sr-meta">${d.meta.description?.slice(0, 60) ?? ''}</span>
						</a>`;
					})
				)).join('');
				results.innerHTML = html;
			}, 200);
		});
	}

	initSearch();
</script>
