---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import { readingTime } from '../utils/reading-time';
import { themeCover } from '../utils/theme-cover';
import { sortPosts } from '../utils/sort-posts';

const posts = sortPosts(await getCollection('blog'));
const pageSize = 12;
const [featured, ...rest] = posts;
const gridPosts = rest.slice(0, pageSize - 1);
const last = Math.max(1, Math.ceil(posts.length / pageSize));

// 主题 / 系列计数，用于首页「按桶浏览」入口
const themeCounts = new Map<string, number>();
const seriesCounts = new Map<string, number>();
for (const post of posts) {
	const t = post.data.theme || '随笔';
	themeCounts.set(t, (themeCounts.get(t) ?? 0) + 1);
	if (post.data.series) seriesCounts.set(post.data.series, (seriesCounts.get(post.data.series) ?? 0) + 1);
}
const themes = [...themeCounts.entries()]
	.map(([name, count]) => ({ name, count }))
	.sort((a, b) => b.count - a.count);
const seriesList = [...seriesCounts.entries()]
	.map(([name, count]) => ({ name, count }))
	.sort((a, b) => b.count - a.count);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 1.25rem;
			}

			/* ===== 站点身份区（masthead） ===== */
			/* 满幅 hero：用负 margin 突破 960px 内容栏，让聚光能横跨整个视口，
			   避免鼠标靠近两侧时被窄栏裁出硬边；文字再用内层容器收回 960px */
			.masthead {
				position: relative;
				overflow: hidden;
				margin-left: calc(50% - 50vw);
				margin-right: calc(50% - 50vw);
			}

			.masthead-inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 5rem 1.25rem 3rem;
				border-bottom: 1px solid var(--border-color);
				position: relative;
				z-index: 1;
			}

			/* 首页聚光：一团主题色柔光跟着鼠标走，融进背景 */
			.masthead::after {
				content: "";
				position: absolute;
				inset: 0;
				z-index: 0;
				pointer-events: none;
				background: radial-gradient(
					600px circle at var(--mx, 50%) var(--my, 50%),
					color-mix(in srgb, var(--primary-color) 18%, transparent),
					transparent 68%
				);
			}

			.kicker {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				font-weight: 500;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin: 0 0 1.4rem;
			}

			.statement {
				font-size: 2.6rem;
				font-weight: 600;
				line-height: 1.18;
				letter-spacing: -0.02em;
				margin: 0 0 1.3rem;
				color: var(--text-main);
				max-width: 18ch;
			}

			.lede {
				font-size: 1.15rem;
				line-height: 1.75;
				color: var(--text-secondary);
				margin: 0;
				max-width: 34rem;
			}

			/* ===== 精选首篇 ===== */
			.featured {
				padding: 3rem 0 1rem;
			}

			.featured-link {
				display: flex;
				gap: 2rem;
				align-items: stretch;
				text-decoration: none;
				color: var(--text-main);
				border-radius: 20px;
				padding: 1.25rem;
				border: 1px solid transparent;
				transition:
					background 0.25s ease,
					border-color 0.25s ease;
			}

			.featured-link:hover {
				background: color-mix(in srgb, var(--primary-soft) 12%, transparent);
				border-color: color-mix(in srgb, var(--primary-color) 22%, transparent);
			}

			.featured-thumb {
				width: 300px;
				flex-shrink: 0;
				border-radius: 14px;
				overflow: hidden;
				background: color-mix(in srgb, var(--primary-soft) 28%, var(--background-body));
			}

			.featured-thumb :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.4s ease;
			}

			.featured-link:hover .featured-thumb :global(img) {
				transform: scale(1.04);
			}

			.featured-body {
				flex: 1;
				min-width: 0;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.featured-tag {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin: 0 0 0.9rem;
			}

			.featured-title {
				font-size: 1.7rem;
				font-weight: 700;
				line-height: 1.3;
				margin: 0 0 0.7rem;
				color: var(--text-main);
			}

			.featured-excerpt {
				font-size: 1rem;
				line-height: 1.65;
				color: var(--text-secondary);
				margin: 0 0 1rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.featured-date {
				margin-top: auto;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--text-secondary);
			}

			.featured-date .dot {
				margin: 0 0.45rem;
				opacity: 0.6;
			}

			/* ===== 其余列表 ===== */
			.recent-posts {
				padding: 2.5rem 0 1rem;
			}

			.recent-posts-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.2rem;
			}

			.recent-posts-head h2 {
				font-size: 0.82rem;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--text-secondary);
				margin: 0;
			}

			.recent-posts-head .view-all {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--primary-color);
				text-decoration: none;
			}

			.recent-posts-head .view-all:hover {
				color: var(--primary-strong);
			}

			/* ===== 按主题 / 系列浏览 ===== */
			.browse {
				padding: 2.75rem 0 1rem;
				margin-top: 1rem;
				border-top: 1px solid var(--border-color);
			}

			.browse-group + .browse-group {
				margin-top: 1.75rem;
			}

			.browse-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.1rem;
			}

			.browse-head h2 {
				font-size: 0.82rem;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--text-secondary);
				margin: 0;
			}

			.browse-head .view-all {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--primary-color);
				text-decoration: none;
			}

			.browse-head .view-all:hover {
				color: var(--primary-strong);
			}

			.browse-chips {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
			}

			.chip {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				text-decoration: none;
				font-size: 0.92rem;
				color: var(--text-main);
				padding: 0.45rem 0.85rem;
				border: 1px solid var(--border-color);
				border-radius: 99em;
				background: var(--surface);
				transition:
					border-color 0.2s ease,
					background 0.2s ease,
					color 0.2s ease,
					transform 0.2s ease;
			}

			.chip:hover {
				border-color: var(--primary-color);
				color: var(--primary-color);
				transform: translateY(-2px);
			}

			.chip .count {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--text-secondary);
				background: color-mix(in srgb, var(--primary-soft) 32%, transparent);
				padding: 0.05rem 0.45rem;
				border-radius: 99em;
			}

			/* 小红书式：竖向卡片网格（左→右按时间流） */
			.post-list {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
			}

			@media (max-width: 900px) {
				.post-list {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (max-width: 720px) {
				.masthead {
					padding: 3.5rem 0 2.5rem;
				}
				.statement {
					font-size: 2rem;
				}
				.featured {
					padding: 2.5rem 0 0.5rem;
				}
				.featured-link {
					flex-direction: column;
					gap: 1.1rem;
					padding: 0.5rem;
				}
				.featured-thumb {
					width: 100%;
					height: 200px;
				}
				.featured-title {
					font-size: 1.4rem;
				}
			}

			@media (max-width: 560px) {
				.post-list {
					grid-template-columns: 1fr; /* 手机上文章卡片单列，避免挤成两列 */
				}
			}

			@media (max-width: 480px) {
				.statement {
					font-size: 1.7rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="masthead">
				<div class="masthead-inner">
					<p class="kicker">Wang's Notes</p>
					<h1 class="statement">把构建的过程，写成可追溯的笔记。</h1>
					<p class="lede">
						这里收录技术实践、本地 AI 与个人思考。每一篇都来自真实的工程实践，并记录它一路长成的轨迹。
					</p>
				</div>
			</section>

			{
				featured && (
					<section class="featured">
						<a class="featured-link" href={`/blog/${featured.id}/`}>
						<div class="featured-thumb">
							{featured.data.heroImage ? (
								<Image src={featured.data.heroImage} alt="" width={600} height={400} />
							) : (
								<img src={themeCover(featured.data.theme)} alt="" width={600} height={400} loading="lazy" />
							)}
						</div>
							<div class="featured-body">
								<p class="featured-tag">最新发布</p>
								<h2 class="featured-title">{featured.data.title}</h2>
								{featured.data.description && (
									<p class="featured-excerpt">{featured.data.description}</p>
								)}
								<span class="featured-date">
									<FormattedDate date={featured.data.pubDate} />
									<span class="dot">·</span>
									{readingTime(featured.body)}
								</span>
							</div>
						</a>
					</section>
				)
			}

			<section class="recent-posts">
				<div class="recent-posts-head">
					<h2>全部文章</h2>
					<a class="view-all" href="/blog">查看归档 →</a>
				</div>
				<div class="post-list">
					{gridPosts.map((post) => <PostCard post={post} />)}
				</div>
				<Pagination current={1} last={last} baseHref="/page/" firstHref="/" />
			</section>

			<section class="browse">
				<div class="browse-group">
					<div class="browse-head">
						<h2>按主题浏览</h2>
						<a class="view-all" href="/categories">全部分类 →</a>
					</div>
					<div class="browse-chips">
						{
							themes.map((t) => (
								<a class="chip" href={`/themes/${encodeURIComponent(t.name)}/`}>
									{t.name}
									<span class="count">{t.count}</span>
								</a>
							))
						}
					</div>
				</div>
				{
					seriesList.length > 0 && (
						<div class="browse-group">
							<div class="browse-head">
								<h2>按系列浏览</h2>
							</div>
							<div class="browse-chips">
								{
									seriesList.map((s) => (
										<a class="chip" href={`/series/${encodeURIComponent(s.name)}/`}>
											{s.name}
											<span class="count">{s.count}</span>
										</a>
									))
								}
							</div>
						</div>
					)
				}
			</section>
		</main>
		<Footer />
		<script>
			const mast = document.querySelector('.masthead');
			if (mast && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				let raf = 0;
				let px = 0, py = 0;
				mast.addEventListener('pointermove', (e) => {
					const r = mast.getBoundingClientRect();
					px = e.clientX - r.left;
					py = e.clientY - r.top;
					if (!raf)
						raf = requestAnimationFrame(() => {
							mast.style.setProperty('--mx', px + 'px');
							mast.style.setProperty('--my', py + 'px');
							raf = 0;
						});
				});
			}
		</script>
	</body>
</html>
