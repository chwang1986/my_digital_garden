---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Pagination from '../../components/Pagination.astro';
import { sortPosts } from '../../utils/sort-posts';
import { SITE_TITLE } from '../../consts';

const all = sortPosts(await getCollection('blog'));
const pageSize = 12;
const posts = all.slice(0, pageSize);
const last = Math.max(1, Math.ceil(all.length / pageSize));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`全部文章 - ${SITE_TITLE}`} description="全部文章：标题、主题、时间与标签。" />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}

			.page-head h1 {
				margin: 0 0 0.5rem;
			}

			.page-head p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.05rem;
			}

			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				border-top: 1px solid var(--border-color);
			}

			.post-item {
				padding: 1.1rem 0.25rem;
				border-bottom: 1px solid var(--border-color);
				transition:
					background 0.2s ease,
					padding 0.2s ease;
			}

			.post-item:hover {
				background: color-mix(in srgb, var(--primary-soft) 10%, transparent);
				padding-left: 0.6rem;
			}

			.post-main {
				display: flex;
				flex-direction: column;
				gap: 0.45rem;
			}

			.post-title {
				font-size: 1.12rem;
				font-weight: 600;
				line-height: 1.4;
				color: var(--text-main);
				text-decoration: none;
			}

			.post-item:hover .post-title {
				color: var(--primary-color);
			}

			.post-title:hover {
				text-decoration: underline;
			}

			.post-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.82rem;
				color: var(--text-secondary);
				font-family: var(--font-mono);
			}

			.post-meta .dot {
				color: var(--border-color);
			}

			.post-meta .theme {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--primary-color);
				text-decoration: none;
				padding: 0.12rem 0.55rem;
				border-radius: 99em;
				background: color-mix(in srgb, var(--primary-soft) 55%, transparent);
				border: 1px solid color-mix(in srgb, var(--primary-color) 28%, transparent);
				transition:
					background 0.2s ease,
					color 0.2s ease;
			}

			.post-meta .theme:hover {
				background: var(--primary-color);
				color: var(--on-accent);
			}

			.post-meta .tag {
				font-family: var(--font-mono);
				font-size: 0.76rem;
				color: var(--primary-color);
				text-decoration: none;
				padding: 0.12rem 0.5rem;
				border-radius: 99em;
				background: color-mix(in srgb, var(--primary-soft) 50%, transparent);
				border: 1px solid color-mix(in srgb, var(--primary-color) 24%, transparent);
				transition:
					background 0.2s ease,
					color 0.2s ease;
			}

			.post-meta .tag:hover {
				background: var(--primary-color);
				color: var(--on-accent);
			}

			@media (max-width: 480px) {
				.post-main {
					gap: 0.35rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<a class="back" href="/themes">← 按主题浏览</a>
				<h1>全部文章</h1>
				<p>标题、主题、时间与标签，一张清单看全部。</p>
			</header>
			<ul class="post-list">
				{
					posts.map((post) => {
						const theme = post.data.theme ?? '随笔';
						return (
							<li class="post-item">
								<div class="post-main">
									<a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
									<div class="post-meta">
										<FormattedDate date={post.data.pubDate} />
										<span class="dot">·</span>
										<a class="theme" href={`/themes/${encodeURIComponent(theme)}/`}>{theme}</a>
										{post.data.tags.map((t) => (
											<a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>
										))}
									</div>
								</div>
							</li>
						);
					})
				}
			</ul>
			<Pagination current={1} last={last} baseHref="/posts/page/" firstHref="/posts/" />
		</main>
		<Footer />
	</body>
</html>
