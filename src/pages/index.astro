---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { readingTime } from '../utils/reading-time';
import { sortPosts } from '../utils/sort-posts';
import { notes } from '../data/notes';
import { themeDesc, fallbackDesc } from '../data/themes';

const allPosts = sortPosts(await getCollection('blog'));

// 主题计数 + 一句话描述
const themeCounts = new Map<string, number>();
for (const post of allPosts) {
	const t = post.data.theme || '随笔';
	themeCounts.set(t, (themeCounts.get(t) ?? 0) + 1);
}
const themes = [...themeCounts.entries()]
	.map(([name, count]) => ({ name, count, desc: themeDesc[name] ?? fallbackDesc }))
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh'))
	.slice(0, 4);

const doctorPosts = allPosts.filter((p) => p.data.theme === '机器博士说');
const doctorLatest = doctorPosts.slice(0, 3);
const doctorCount = doctorPosts.length;

// 焦点大卡：最新一篇（置顶优先；机器博士说发刊文有专属专栏区，不占头条）
const featured = allPosts.find((p) => p.data.theme !== '机器博士说') ?? null;
// 最新文章：除机器博士说专栏外的近期两篇（专栏已有专属 band，避免重复）
const recentTwo = allPosts.filter((p) => p.data.theme !== '机器博士说').slice(1, 3);

const latestNote = [...notes].sort((a, b) => (a.date < b.date ? 1 : -1))[0] ?? null;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 1080px;
				margin: 0 auto;
				padding: 0 1.25rem;
			}

			/* ===== 紧凑引言：3 秒说清站是什么 ===== */
			.intro {
				padding: 4rem 0 2.5rem;
				max-width: 40rem;
			}
			.intro .kick {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin: 0 0 1.2rem;
			}
			.intro h1 {
				font-size: 2.6rem;
				font-weight: 800;
				line-height: 1.15;
				letter-spacing: -0.03em;
				margin: 0 0 1rem;
				color: var(--text-main);
			}
			.intro p {
				font-size: 1.1rem;
				line-height: 1.75;
				color: var(--text-secondary);
				margin: 0;
			}

			/* ===== Bento 异形网格 ===== */
			.bento {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				grid-template-areas:
					'feat feat doc   doc'
					'feat feat note  note'
					'news news tools themes';
				gap: 1.25rem;
				padding-bottom: 3rem;
			}

			.card {
				display: flex;
				flex-direction: column;
				padding: 1.45rem 1.6rem;
				text-decoration: none;
				color: inherit;
			}
			.card .kick {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin: 0 0 0.8rem;
			}
			.card .kick.violet {
				color: var(--primary-2);
			}
			.card .more {
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--primary-2);
				text-decoration: none;
				margin-top: auto;
				align-self: flex-start;
			}
			.card .more:hover {
				color: var(--primary-strong);
			}

			/* 焦点大卡：全页唯一视觉焦点 */
			.feat {
				grid-area: feat;
				padding: 2.2rem 2.3rem;
				justify-content: center;
			}
			.feat .kick {
				font-size: 0.8rem;
				margin-bottom: 1rem;
			}
			.feat h2 {
				font-size: 2.1rem;
				font-weight: 800;
				line-height: 1.18;
				letter-spacing: -0.02em;
				margin: 0 0 0.9rem;
				color: var(--text-main);
			}
			.feat p {
				font-size: 1.05rem;
				line-height: 1.7;
				color: var(--text-secondary);
				margin: 0 0 1.3rem;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.feat .meta {
				font-size: 0.78rem;
				color: var(--text-secondary);
				margin-bottom: 0.7rem;
			}
			.feat .go {
				font-size: 0.92rem;
				font-weight: 600;
				color: var(--primary-color);
			}

			/* 机器博士说：普通栏目，紫色仅作标签 */
			.doc {
				grid-area: doc;
			}
			.doc-list {
				list-style: none;
				margin: 0 0 0.9rem;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.55rem;
				flex: 1;
			}
			.doc-list li a {
				font-size: 1rem;
				font-weight: 500;
				line-height: 1.4;
				color: var(--text-main);
				text-decoration: none;
				display: -webkit-box;
				-webkit-line-clamp: 1;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.doc-list li a:hover {
				color: var(--primary-2);
			}

			/* 本周随想：紫左线 */
			.note {
				grid-area: note;
				border-left: 3px solid var(--primary-2);
			}
			.note .txt {
				font-size: 0.98rem;
				line-height: 1.7;
				color: var(--text-main);
				margin: 0 0 0.9rem;
				display: -webkit-box;
				-webkit-line-clamp: 4;
				-webkit-box-orient: vertical;
				overflow: hidden;
				flex: 1;
			}

			/* 最新文章：两篇列表 */
			.news {
				grid-area: news;
			}
			.news ul {
				list-style: none;
				margin: 0 0 0.9rem;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.7rem;
				flex: 1;
			}
			.news li a {
				text-decoration: none;
				color: var(--text-main);
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				font-size: 1rem;
				line-height: 1.4;
			}
			.news li a:hover {
				color: var(--primary-color);
			}
			.news .date {
				font-family: var(--font-mono);
				font-size: 0.74rem;
				color: var(--text-secondary);
				white-space: nowrap;
			}

			/* 工具箱 / 主题地图：入口卡 */
			.tools,
			.themes {
				grid-area: tools;
			}
			.themes {
				grid-area: themes;
			}
			.tools h3,
			.themes h3 {
				font-size: 1.1rem;
				font-weight: 700;
				margin: 0 0 0.5rem;
				color: var(--text-main);
			}
			.tools p {
				font-size: 0.9rem;
				line-height: 1.6;
				color: var(--text-secondary);
				margin: 0 0 0.9rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.tools .sub,
			.themes .sub {
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--primary-color);
				margin-top: auto;
				align-self: flex-start;
				text-decoration: none;
			}
			.themes .theme-title {
				text-decoration: none;
				color: inherit;
			}
			.themes .theme-title h3 {
				margin: 0 0 0.5rem;
			}
			.themes ul {
				list-style: none;
				margin: 0 0 0.8rem;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				flex: 1;
			}
			.themes li a {
				text-decoration: none;
				color: var(--text-main);
				font-size: 0.9rem;
				display: flex;
				justify-content: space-between;
				gap: 0.5rem;
			}
			.themes li a:hover {
				color: var(--primary-color);
			}
			.themes .c {
				font-size: 0.72rem;
				color: var(--text-secondary);
				white-space: nowrap;
			}

			@media (max-width: 900px) {
				.bento {
					grid-template-columns: repeat(2, 1fr);
					grid-template-areas:
						'feat feat'
						'doc  note'
						'news news'
						'tools themes';
				}
				.feat h2 {
					font-size: 1.8rem;
				}
			}
			@media (max-width: 560px) {
				.intro {
					padding: 2.8rem 0 2rem;
				}
				.intro h1 {
					font-size: 2rem;
				}
				.bento {
					grid-template-columns: 1fr;
					grid-template-areas:
						'feat'
						'doc'
						'note'
						'news'
						'tools'
						'themes';
				}
				.feat h2 {
					font-size: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p class="kick">Wang's Notes</p>
				<h1><span class="gradient-text">把构建的过程</span>，写成可追溯的笔记。</h1>
				<p>这里收录技术实践、本地 AI 与个人思考。每一篇都来自真实工程，并记录它一路长成的轨迹。</p>
			</section>

			<div class="bento">
				{
					featured && (
						<a class="card feat glow-card" href={`/blog/${featured.id}/`}>
							<span class="kick mono-tag">{featured.data.theme}</span>
							<h2>{featured.data.title}</h2>
							{featured.data.description && <p>{featured.data.description}</p>}
							<span class="meta mono-tag">
								<FormattedDate date={featured.data.pubDate} />
								<span> · </span>
								{readingTime(featured.body)}
							</span>
							<span class="go">阅读 →</span>
						</a>
					)
				}

				<div class="card doc glow-card">
					<span class="kick violet mono-tag">机器博士说</span>
					<ul class="doc-list">
						{
							doctorLatest.map((p) => (
								<li>
									<a href={`/blog/${p.id}/`}>{p.data.title}</a>
								</li>
							))
						}
					</ul>
					<a class="more" href={`/themes/${encodeURIComponent('机器博士说')}/`}>
						看全部 {doctorCount} 篇 →
					</a>
				</div>

				{
					latestNote && (
						<div class="card note glow-card">
							<span class="kick violet mono-tag">本周随想</span>
							<p class="txt">{latestNote.text}</p>
							<a class="more" href="/themes/瞎想/">更多随想 →</a>
						</div>
					)
				}

				<div class="card news glow-card">
					<span class="kick mono-tag">最新文章</span>
					<ul>
						{
							recentTwo.map((p) => (
								<li>
									<a href={`/blog/${p.id}/`}>
										{p.data.title}
										<span class="date">
											<FormattedDate date={p.data.pubDate} />
										</span>
									</a>
								</li>
							))
						}
					</ul>
					<a class="more" href="/blog">全部文章 →</a>
				</div>

				<a class="card tools glow-card" href="/tools">
					<span class="kick mono-tag">小工具</span>
					<h3>实用小工具</h3>
					<p>JSON、Base64、时间戳、密码生成……日常用得上的转换器。</p>
					<span class="sub">打开工具箱 →</span>
				</a>

				<div class="card themes glow-card">
					<span class="kick mono-tag">主题地图</span>
					<a class="theme-title" href="/themes">
						<h3>按主题逛</h3>
					</a>
					<ul>
						{
							themes.map((t) => (
								<li>
									<a href={`/themes/${encodeURIComponent(t.name)}/`}>
										<span>{t.name}</span>
										<span class="c">{t.count} 篇</span>
									</a>
								</li>
							))
						}
					</ul>
					<a class="sub" href="/themes">完整地图 →</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
