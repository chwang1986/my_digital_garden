---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { seriesMeta } from '../../data/series';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const set = new Set<string>();
	for (const p of posts) if (p.data.series) set.add(p.data.series);
	return [...set].map((series) => ({
		params: { series },
		props: {
			series,
			posts: posts
				.filter((p) => p.data.series === series)
				.sort((a, b) => {
					const ao = a.data.order ?? 9999;
					const bo = b.data.order ?? 9999;
					if (ao !== bo) return ao - bo;
					return a.data.pubDate.valueOf() - b.data.pubDate.valueOf();
				}),
		},
	}));
}

const { series, posts } = Astro.props;
const meta = seriesMeta[series];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${series} - ${SITE_TITLE}`} description={meta?.description ?? `系列「${series}」下的文章`} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}
			.page-head {
				margin-bottom: 2rem;
			}
			.page-head .back {
				display: inline-block;
				font-size: 0.85rem;
				color: var(--text-secondary);
				text-decoration: none;
				margin-bottom: 0.8rem;
			}
			.page-head .back:hover {
				color: var(--primary-color);
			}
			.page-head h1 {
				font-size: 2.4rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				margin: 0 0 0.8rem;
			}
			.page-head h1 .mark {
				color: var(--primary-color);
			}
			.series-desc {
				margin: 0;
				font-size: 1.08rem;
				line-height: 1.7;
				color: var(--text-secondary);
				max-width: 60ch;
			}
			.plan {
				margin: 1.6rem 0 0;
				padding: 1.1rem 1.3rem;
				border: 1px dashed color-mix(in srgb, var(--primary-color) 35%, transparent);
				border-radius: 12px;
				background: color-mix(in srgb, var(--primary-soft) 22%, transparent);
			}
			.plan h3 {
				margin: 0 0 0.6rem;
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				color: var(--primary-color);
				font-family: var(--font-mono);
			}
			.plan ul {
				margin: 0;
				padding-left: 1.2rem;
				color: var(--text-secondary);
				font-size: 0.95rem;
				line-height: 1.8;
			}
			.post-list {
				list-style: none;
				margin: 2.5rem 0 0;
				padding: 0;
				border-top: 1px solid var(--border-color);
			}
			.post-item {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1.5rem;
				padding: 1.1rem 0.25rem;
				border-bottom: 1px solid var(--border-color);
				text-decoration: none;
				color: var(--text-main);
				transition:
					color 0.2s ease,
					padding 0.2s ease;
			}
			.post-item:hover {
				color: var(--primary-color);
				padding-left: 0.6rem;
			}
			.post-title {
				font-size: 1.15rem;
				font-weight: 600;
				line-height: 1.4;
			}
			.post-order {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--primary-color);
				margin-right: 0.5rem;
			}
			.post-meta {
				flex-shrink: 0;
				font-size: 0.85rem;
				color: var(--text-secondary);
				font-family: var(--font-mono);
			}
			@media (max-width: 480px) {
				.post-item {
					flex-direction: column;
					gap: 0.3rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<a class="back" href="/series">← 全部系列</a>
				<h1><span class="mark">▍</span>{series}</h1>
				{/* 系列主题 / 简介 */}
				<p class="series-desc">{meta?.description ?? `「${series}」是一个有序的连续篇。`}</p>
				{
					meta?.plan && meta.plan.length > 0 && (
						<div class="plan">
							<h3>系列规划（待发布）</h3>
							<ul>
								{meta.plan.map((t) => (
									<li>{t}</li>
								))}
							</ul>
						</div>
					)
				}
			</header>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a class="post-item" href={`/blog/${post.id}/`}>
								<span class="post-title">
									{post.data.order != null && <span class="post-order">#{post.data.order}</span>}
									{post.data.title}
								</span>
								<span class="post-meta">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
