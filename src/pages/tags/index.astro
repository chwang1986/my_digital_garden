---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const p of posts) {
	for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`标签 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}
			.page-head {
				margin-bottom: 2.5rem;
			}
			.page-head h1 {
				font-size: 2.2rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				margin: 0 0 0.5rem;
			}
			.page-head p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.15rem;
			}
			.tag-cloud {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
		.tag-cloud a {
			display: inline-flex;
			align-items: baseline;
			gap: 0.4rem;
			text-decoration: none;
			color: var(--text-main);
			border: 1px solid var(--border-color);
			border-radius: 8px;
			padding: 0.4rem 0.85rem;
			font-size: 0.92rem;
			transition: border-color 0.2s ease, color 0.2s ease;
		}
		.tag-cloud a:hover {
			border-color: var(--primary-color);
			color: var(--primary-color);
		}
		.tag-cloud .count {
			font-family: var(--font-mono);
			font-size: 0.78rem;
			opacity: 0.7;
		}
		.all-link {
			margin-top: 2.2rem;
			font-size: 0.95rem;
		}
		.all-link a {
			color: var(--primary-color);
			text-decoration: none;
			border-bottom: 1px solid color-mix(in srgb, var(--primary-color) 40%, transparent);
			padding-bottom: 1px;
			transition: border-color 0.2s ease;
		}
		.all-link a:hover {
			border-color: var(--primary-color);
		}
		@media (max-width: 600px) {
				.page-head h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>标签</h1>
				<p>文章里出现过的自由标签，按使用次数排列。点进去看带这个标签的文章。</p>
			</header>
			{
				tags.length > 0 ? (
					<div class="tag-cloud">
						{tags.map(([t, n]) => (
							<a href={`/tags/${encodeURIComponent(t)}/`}>
								{t}
								<span class="count">{n}</span>
							</a>
						))}
					</div>
				) : (
					<p>还没有标签。</p>
				)
			}
			<p class="all-link">
				<a href="/themes">换个角度看：按主题归类 →</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
