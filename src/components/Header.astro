---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
---

	<header>
		<nav>
			<h2><a href="/">Wang's <span class="logo-accent">Notes</span></a></h2>

		<div class="nav-links">
			<div class="internal-links">
				<HeaderLink href="/">首页</HeaderLink>
				<HeaderLink href="/blog">文章</HeaderLink>
				<HeaderLink href="/categories">分类</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
			</div>
			<ThemeToggle />
			<Search />
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--border-color);
		background-color: color-mix(in srgb, var(--bg-color) 88%, transparent);
		transition: background-color 0.2s ease, border-color 0.2s ease;
		position: sticky;
		top: 0;
		z-index: 10;
		backdrop-filter: saturate(180%) blur(8px);
		-webkit-backdrop-filter: saturate(180%) blur(8px);
	}

	nav {
		max-width: var(--wide-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	h2 {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	h2 a {
		color: var(--text-color);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	h2 a:hover {
		color: var(--accent-color);
	}

	.logo-accent {
		background: linear-gradient(100deg, var(--primary-color), var(--primary-2));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.1rem;
	}

	.internal-links :global(a) {
		padding: 0.25rem 0;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.internal-links :global(a:hover) {
		color: var(--primary-color);
	}

	.internal-links :global(a::after) {
		content: "";
		display: block;
		height: 2px;
		margin-top: 2px;
		background: linear-gradient(90deg, var(--primary-color), var(--primary-2));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
	}

	.internal-links :global(a:hover::after),
	.internal-links :global(a.active::after) {
		transform: scaleX(1);
	}

	.internal-links :global(a.active) {
		color: var(--primary-color);
		font-weight: 600;
	}

	@media (max-width: 600px) {
		header {
			padding: 0.85rem 1rem;
		}

		h2 {
			font-size: 1rem;
		}

		.nav-links {
			gap: 0.85rem;
		}

		.internal-links {
			gap: 0.8rem;
		}

		.internal-links :global(a) {
			font-size: 0.85rem;
		}
	}

	@media (max-width: 420px) {
		h2 {
			display: none;
		}
	}
</style>
