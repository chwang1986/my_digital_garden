---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime?: string;
	prev?: CollectionEntry<'blog'> | null;
	next?: CollectionEntry<'blog'> | null;
	tags?: string[];
	series?: string | null;
	order?: number | null;
	headings?: { depth: number; text: string; slug: string }[];
};

const { title, description, pubDate, updatedDate, heroImage, readingTime, prev, next, tags = [], series = null, order = null, theme = '随笔', headings = [] } = Astro.props;

const slug = Astro.url.pathname.split('/').filter(Boolean)[1] ?? '';
const ogImage = `/og/${slug}`;

const publishedISO = pubDate.toISOString();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: description,
	datePublished: publishedISO,
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: 'Wang' },
	publisher: { '@type': 'Organization', name: 'Wang’s Notes' },
	mainEntityOfPage: Astro.url.toString(),
	image: new URL(ogImage, Astro.site).toString(),
};
---

<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			ogImage={ogImage}
			ogType="article"
			publishedTime={publishedISO}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			/* 阅读进度条 */
			.progress {
				position: fixed;
				top: 0;
				left: 0;
				height: 3px;
				width: 0;
				background: var(--primary-color);
				z-index: 30;
				transition: width 0.1s linear;
			}

			main {
				width: 100%;
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 2.5rem 1.25rem 1rem;
			}

			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 0.9rem;
				font-weight: 500;
				color: var(--text-secondary);
				text-decoration: none;
				margin-bottom: 1.5rem;
				transition: color 0.2s ease;
			}

			.back-link:hover {
				color: var(--primary-color);
			}

			.prose {
				max-width: var(--content-width);
				margin: 0 auto;
			}

			.post-header {
				margin-bottom: 1.5rem;
			}

			.hero-image {
				width: 100%;
				margin: 0 0 2rem;
			}

			.hero-image img {
				display: block;
				width: 100%;
				max-height: 380px;
				object-fit: cover;
				border-radius: 18px;
				box-shadow: var(--shadow-md);
			}

			.series {
				display: inline-block;
				margin: 0 0 0.6rem;
				font-family: var(--font-mono);
				font-size: 0.8rem;
				letter-spacing: 0.08em;
				color: var(--primary-color);
				text-decoration: none;
				transition:
					color 0.2s ease,
					opacity 0.2s ease;
			}

			.series:hover {
				opacity: 0.7;
				text-decoration: underline;
			}

			.theme-pill {
				display: inline-flex;
				align-items: center;
				align-self: flex-start;
				margin: 0 0 0.7rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.04em;
				text-decoration: none;
				color: var(--primary-color);
				padding: 0.22rem 0.7rem;
				border-radius: 99em;
				background: color-mix(in srgb, var(--primary-soft) 55%, transparent);
				border: 1px solid color-mix(in srgb, var(--primary-color) 28%, transparent);
				transition:
					background 0.2s ease,
					color 0.2s ease;
			}

			.theme-pill:hover {
				background: var(--primary-color);
				color: var(--on-accent);
			}

			.post-header h1 {
				margin: 0;
				font-size: 2.5rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				line-height: 1.2;
				color: var(--text-main);
			}

			.lead {
				margin: 0.9rem 0 0;
				font-size: 1.1rem;
				line-height: 1.7;
				color: var(--text-secondary);
				max-width: 38rem;
			}

			.meta-row {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.6rem 1.1rem;
				margin-top: 1.3rem;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}

			.tag {
				font-size: 0.75rem;
				font-family: var(--font-mono);
				color: var(--primary-color);
				text-decoration: none;
				padding: 0.18rem 0.6rem;
				border: 1px solid color-mix(in srgb, var(--primary-color) 35%, transparent);
				border-radius: 99em;
				transition:
					background 0.2s ease,
					color 0.2s ease;
			}

			.tag:hover {
				background: var(--primary-color);
				color: var(--on-accent);
			}

			.meta-info {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--text-secondary);
			}

			.meta-info .dot {
				margin: 0 0.4rem;
				opacity: 0.6;
			}

			.last-updated-on {
				font-style: italic;
				color: var(--text-secondary);
				font-size: 0.9rem;
				margin-left: 0.4rem;
			}

			.share {
				margin: 0;
			}

			.share a {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				color: var(--primary-color);
				font-size: 0.92rem;
				text-decoration: none;
				transition: opacity 0.2s ease;
			}

			.share a:hover {
				opacity: 0.72;
			}

			.share svg {
				width: 16px;
				height: 16px;
				fill: currentColor;
			}


			.divider {
				width: 3rem;
				height: 3px;
				margin: 1.5rem auto 0;
				border: none;
				background: var(--primary-color);
				border-radius: 2px;
			}

			/* 代码块复制按钮 */
			.prose :global(pre) {
				position: relative;
			}

			.copy-btn {
				position: absolute;
				top: 0.7rem;
				right: 0.7rem;
				z-index: 2;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.3rem 0.6rem;
				font-size: 0.75rem;
				font-family: var(--font-mono);
				color: var(--text-secondary);
				background: color-mix(in srgb, var(--surface) 80%, transparent);
				border: 1px solid var(--border-color);
				border-radius: 7px;
				cursor: pointer;
				opacity: 0;
				transition:
					opacity 0.2s ease,
					color 0.2s ease,
					border-color 0.2s ease;
			}

			.prose :global(pre):hover .copy-btn {
				opacity: 1;
			}

			.copy-btn:hover {
				color: var(--primary-color);
				border-color: var(--primary-color);
			}

			.copy-btn.copied {
				color: var(--primary-color);
				border-color: var(--primary-color);
			}

			/* 正文末尾 AI 生成声明 */
			.ai-byline {
				margin: 2.5rem 0 0;
				padding-top: 1.2rem;
				border-top: 1px solid var(--border-color);
				text-align: center;
				font-family: var(--font-mono);
				font-size: 0.8rem;
				letter-spacing: 0.05em;
				color: color-mix(in srgb, var(--text-secondary) 72%, var(--primary-color));
			}

			/* 文章末尾 CTA */
			.post-cta {
				margin: 1.5rem 0 0;
				padding: 1rem 1.1rem;
				background: color-mix(in srgb, var(--primary-soft) 14%, transparent);
				border: 1px solid color-mix(in srgb, var(--primary-color) 18%, var(--border-color));
				border-radius: 12px;
				text-align: center;
			}

			.post-cta p {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.7;
				color: var(--text-secondary);
			}

			.post-cta a {
				color: var(--primary-color);
				text-decoration: none;
				font-weight: 600;
			}

			.post-cta a:hover {
				text-decoration: underline;
				color: var(--primary-color);
				box-shadow: none;
			}

			/* 目录 (ToC) */
			.toc {
				margin: 1.2rem 0 2rem;
				padding: 0.9rem 1.1rem;
				background: color-mix(in srgb, var(--surface) 80%, transparent);
				border: 1px solid var(--border-color);
				border-radius: 12px;
			}

			.toc summary {
				font-family: var(--font-display);
				font-size: 1rem;
				font-weight: 600;
				color: var(--text-main);
				cursor: pointer;
				list-style: none;
			}

			.toc summary::-webkit-details-marker { display: none; }

			.toc summary::before {
				content: '§';
				margin-right: 0.6rem;
				color: var(--primary-color);
				font-family: var(--font-mono);
			}

			.toc nav {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				margin-top: 0.7rem;
				padding-left: 0.3rem;
				border-left: 2px solid color-mix(in srgb, var(--primary-color) 28%, transparent);
			}

			.toc-item, .toc-sub {
				font-size: 0.92rem;
				line-height: 1.6;
				color: var(--text-secondary);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.toc-item:hover, .toc-sub:hover { color: var(--primary-color); }

			.toc-sub {
				font-size: 0.85rem;
				padding-left: 1.2rem;
			}

			/* 代码块语言标签 */
			.prose :global(pre[data-lang])::before {
				content: attr(data-lang);
				position: absolute;
				top: 0.5rem;
				left: 0.75rem;
				z-index: 1;
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.04em;
				color: var(--text-secondary);
				opacity: 0.55;
			}

			.prose :global(pre[data-lang]) {
				padding-top: 1.8rem;
			}

			/* 回到顶部按钮 */
			.back-to-top {
				position: fixed;
				bottom: 1.8rem;
				right: 1.8rem;
				z-index: 20;
				width: 40px;
				height: 40px;
				border-radius: 50%;
				border: 1px solid var(--border-color);
				background: var(--surface);
				color: var(--text-secondary);
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0;
				visibility: hidden;
				transform: translateY(8px);
				transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease, color 0.2s ease, border-color 0.2s ease;
				box-shadow: var(--shadow-sm);
			}

			.back-to-top:hover {
				color: var(--primary-color);
				border-color: var(--primary-color);
			}

			.back-to-top.visible {
				opacity: 1;
				visibility: visible;
				transform: translateY(0);
			}

			/* 上一篇 / 下一篇 */
			.pager {
				max-width: var(--content-width);
				margin: 2.5rem auto 0;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}

			.pager a {
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				padding: 1rem 1.1rem;
				border: 1px solid var(--border-color);
				border-radius: 14px;
				text-decoration: none;
				color: var(--text-main);
				transition:
					border-color 0.2s ease,
					background 0.2s ease;
			}

			.pager a:hover {
				border-color: var(--primary-color);
				background: color-mix(in srgb, var(--primary-soft) 10%, transparent);
			}

			.pager .dir {
				font-size: 0.78rem;
				font-family: var(--font-mono);
				color: var(--primary-color);
				letter-spacing: 0.05em;
			}

			.pager .pt {
				font-size: 0.95rem;
				font-weight: 600;
				line-height: 1.4;
			}

			.pager .next {
				text-align: right;
			}

			.pager .empty {
				border: none;
				background: none;
				pointer-events: none;
			}

			@media (max-width: 600px) {
				.pager {
					grid-template-columns: 1fr;
				}
				.pager .next {
					text-align: left;
				}
			}
		</style>
	</head>

	<body>
		<div class="progress" id="progress"></div>
		<Header />
		<main>
			<article>
				<a class="back-link" href="/blog">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M15 18l-6-6 6-6" />
					</svg>
					返回随笔
				</a>

				<div class="prose">
					<div class="post-header">
						<div class="hero-image">
							{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
						</div>
					<div class="head-text">
						{
							theme && (
								<a class="theme-pill" href={`/themes/${encodeURIComponent(theme)}/`}>
									{theme}
								</a>
							)
						}
						{
							series && (
								<a class="series" href={`/series/${encodeURIComponent(series)}/`}>
									{series}{order != null && ` · 第 ${order} 篇`}
								</a>
							)
						}
							<h1>{title}</h1>
							{description && <p class="lead">{description}</p>}
							<div class="meta-row">
								{
									tags.length > 0 && (
										<div class="tags">
											{tags.map((t) => (
												<a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>
											))}
										</div>
									)
								}
								<span class="meta-info">
									<FormattedDate date={pubDate} />
									{
										updatedDate && (
											<span class="last-updated-on">
												· 最后更新于 <FormattedDate date={updatedDate} />
											</span>
										)
									}
									{readingTime && <span class="dot">·</span>}
									{readingTime && <span>{readingTime}</span>}
								</span>
								<div class="share">
									<a
										href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url)}&text=${encodeURIComponent(title)}`}
										target="_blank"
										rel="noopener noreferrer"
									>
										<svg viewBox="0 0 24 24" aria-hidden="true"
											><path
												d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
											></path></svg
										>
										<span>分享到 X</span>
									</a>
								</div>
							</div>
						</div>
						<hr class="divider" />
					</div>

					{
						headings.length > 1 && (
							<details class="toc">
								<summary>目录</summary>
								<nav>
									{headings.map((h) => (
										<a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-sub' : 'toc-item'}>{h.text}</a>
									))}
								</nav>
							</details>
						)
					}
				<slot />
				<p class="ai-byline">人工智能生成 · 人机协同创造</p>

				<div class="post-cta">
					<p>如果这篇对你有启发，欢迎 <a href="https://twitter.com/intent/tweet?url={encodeURIComponent(Astro.url)}&text={encodeURIComponent(title)}" target="_blank" rel="noopener noreferrer">分享到 X</a>，或 <a href="/blog">浏览更多随笔</a>。</p>
				</div>
			</div>

				<nav class="pager" aria-label="文章导航">
					{
						prev ? (
							<a class="prev" href={`/blog/${prev.id}/`}>
								<span class="dir">← 上一篇</span>
								<span class="pt">{prev.data.title}</span>
							</a>
						) : (
							<span class="empty" />
						)
					}
					{
						next ? (
							<a class="next" href={`/blog/${next.id}/`}>
								<span class="dir">下一篇 →</span>
								<span class="pt">{next.data.title}</span>
							</a>
						) : (
							<span class="empty" />
						)
					}
				</nav>
			</article>
		</main>

		<button class="back-to-top" id="back-to-top" aria-label="回到顶部" type="button">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M18 15l-6-6-6 6"/>
			</svg>
		</button>

		<Footer />

		<script>
			// 阅读进度条
			const progress = document.getElementById('progress');
			const onScroll = () => {
				const h = document.documentElement;
				const scrolled = h.scrollTop;
				const height = h.scrollHeight - h.clientHeight;
				const pct = height > 0 ? (scrolled / height) * 100 : 0;
				if (progress) progress.style.width = pct + '%';
			};
			document.addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			// 代码块复制按钮
			document.querySelectorAll('pre').forEach((pre) => {
				const btn = document.createElement('button');
				btn.className = 'copy-btn';
				btn.type = 'button';
				btn.textContent = '复制';
				btn.addEventListener('click', async () => {
					const code = pre.querySelector('code')?.innerText ?? pre.innerText;
					try {
						await navigator.clipboard.writeText(code);
						btn.textContent = '已复制';
						btn.classList.add('copied');
						setTimeout(() => {
							btn.textContent = '复制';
							btn.classList.remove('copied');
						}, 1500);
					} catch {
						btn.textContent = '失败';
					}
				});
				pre.appendChild(btn);
			});

			// 回到顶部按钮
			const backToTop = document.getElementById('back-to-top');
			if (backToTop) {
				document.addEventListener('scroll', () => {
					backToTop.classList.toggle('visible', document.documentElement.scrollTop > 400);
				}, { passive: true });
				backToTop.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
			}

			// 代码块语言标签
			document.querySelectorAll('pre[class*="language-"]').forEach((pre) => {
				const cls = pre.className.match(/language-(\w+)/);
				if (cls) pre.setAttribute('data-lang', cls[1]);
			});
		</script>
	</body>
</html>
