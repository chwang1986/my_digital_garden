---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { sortPosts } from '../../utils/sort-posts';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const set = new Set<string>();
	for (const p of posts) if (p.data.theme) set.add(p.data.theme);
	return [...set].map((theme) => ({
		params: { theme },
		props: {
			theme,
			posts: sortPosts(posts.filter((p) => p.data.theme === theme)),
		},
	}));
}

const { theme, posts } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${theme} - ${SITE_TITLE}`} description={`主题「${theme}」下的文章`} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}
			.page-head {
				margin-bottom: 2.5rem;
			}
			.page-head .back {
				display: inline-block;
				font-size: 0.85rem;
				color: var(--text-secondary);
				text-decoration: none;
				margin-bottom: 0.8rem;
			}
			.page-head .back:hover {
				color: var(--primary-color);
			}
			.page-head h1 {
				font-size: 2.4rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				margin: 0;
			}
			.page-head h1 .mark {
				color: var(--primary-color);
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				border-top: 1px solid var(--border-color);
			}
			.post-item {
				padding: 1.1rem 0.25rem;
				border-bottom: 1px solid var(--border-color);
				transition:
					background 0.2s ease,
					padding 0.2s ease;
			}
			.post-item:hover {
				background: color-mix(in srgb, var(--primary-soft) 10%, transparent);
				padding-left: 0.6rem;
			}
			.post-main {
				display: flex;
				flex-direction: column;
				gap: 0.45rem;
			}
			.post-title {
				font-size: 1.15rem;
				font-weight: 600;
				line-height: 1.4;
				color: var(--text-main);
				text-decoration: none;
			}
			.post-item:hover .post-title {
				color: var(--primary-color);
			}
			.post-title:hover {
				text-decoration: underline;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.82rem;
				color: var(--text-secondary);
				font-family: var(--font-mono);
			}
			.post-meta .dot {
				color: var(--border-color);
			}
			.post-meta .tag {
				font-family: var(--font-mono);
				font-size: 0.76rem;
				color: var(--primary-color);
				text-decoration: none;
				padding: 0.12rem 0.5rem;
				border-radius: 99em;
				background: color-mix(in srgb, var(--primary-soft) 50%, transparent);
				border: 1px solid color-mix(in srgb, var(--primary-color) 24%, transparent);
				transition:
					background 0.2s ease,
					color 0.2s ease;
			}
			.post-meta .tag:hover {
				background: var(--primary-color);
				color: var(--on-accent);
			}
			@media (max-width: 480px) {
				.post-main {
					gap: 0.35rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<a class="back" href="/themes">← 全部主题</a>
				<h1><span class="mark">▍</span>{theme}</h1>
			</header>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li class="post-item">
							<div class="post-main">
								<a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
								<div class="post-meta">
									<FormattedDate date={post.data.pubDate} />
									<span class="dot">·</span>
									{post.data.tags.map((t) => (
										<a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>
									))}
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
