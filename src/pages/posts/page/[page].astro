---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import Pagination from '../../../components/Pagination.astro';
import PostGrid from '../../../components/PostGrid.astro';
import { sortPosts } from '../../../utils/sort-posts';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths({ paginate }) {
	const all = sortPosts(await getCollection('blog'));
	// 第 1 页由 /posts/ 承载，这里只生成第 2 页起
	return paginate(all, { pageSize: 12 }).slice(1);
}

const page = Astro.props.page;
const posts = page.data;
const current = page.currentPage;
const last = page.lastPage;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`全部文章 - 第 ${current} 页 - ${SITE_TITLE}`} description="全部文章：标题、主题、时间与标签。" />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}

			.page-head {
				margin-bottom: 2.5rem;
			}

			.page-head .back {
				display: inline-block;
				font-size: 0.85rem;
				color: var(--text-secondary);
				text-decoration: none;
				margin-bottom: 0.8rem;
			}

			.page-head .back:hover {
				color: var(--primary-color);
			}

			.page-head h1 {
				font-size: 2.4rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				margin: 0 0 0.5rem;
				color: var(--text-main);
			}

			.page-head p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.05rem;
			}

			/* 卡片网格由 PostGrid 组件统一管理 */
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<a class="back" href="/themes">← 按主题浏览</a>
				<h1>全部文章</h1>
				<p>标题、主题、时间与标签，一张清单看全部。</p>
			</header>
			<PostGrid posts={posts} />
			<Pagination current={current} last={last} baseHref="/posts/page/" firstHref="/posts/" />
		</main>
		<Footer />
	</body>
</html>
