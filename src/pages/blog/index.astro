---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostGrid from '../../components/PostGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { sortPosts } from '../../utils/sort-posts';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const all = sortPosts(await getCollection('blog'));
const pageSize = 12;
const posts = all.slice(0, pageSize);
const last = Math.max(1, Math.ceil(all.length / pageSize));

// 标签频次统计（用于标签筛选，取出现最多的前若干）
const tagCounts = new Map<string, number>();
for (const post of all) {
	for (const t of post.data.tags ?? []) {
		tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
	}
}
const tags = [...tagCounts.entries()]
	.map(([name, count]) => ({ name, count }))
	.sort((a, b) => b.count - a.count)
	.slice(0, 12);

// 全部文章链接（随机文章用）
const allLinks = all.map((p) => `/blog/${p.id}/`);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}

			.page-head h1 {
				font-size: 2.2rem;
				margin: 0 0 0.5rem;
			}

			.page-head p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.05rem;
			}

			/* ===== 工具条：标签筛选 + 随便逛逛 + 外观 ===== */
			.tools {
				margin: 2rem 0 2.5rem;
				display: grid;
				grid-template-columns: 1fr 300px;
				gap: 1.5rem;
				align-items: start;
			}

			@media (max-width: 820px) {
				.tools {
					grid-template-columns: 1fr;
				}
			}

			.panel {
				border: 1px solid var(--border-color);
				border-radius: 12px;
				background: var(--surface);
				padding: 1.2rem 1.3rem;
			}

			.panel-title {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.5rem;
				margin: 0 0 0.9rem;
			}

			.panel-title .t {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--primary-color);
			}

			.panel-title .hint {
				font-size: 0.74rem;
				color: var(--text-secondary);
			}

			/* 标签筛选：大小统一、柔和胶囊，始终显示频次 */
			.tag-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.tag-list a {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				text-decoration: none;
				font-family: var(--font-body);
				font-size: 0.86rem;
				line-height: 1;
				color: var(--text-secondary);
				padding: 0.45rem 0.7rem;
				border: 1px solid var(--border-color);
				border-radius: 8px;
				transition:
					color 0.18s ease,
					border-color 0.18s ease,
					background 0.18s ease,
					transform 0.18s ease;
			}

			.tag-list a:hover {
				color: var(--primary-color);
				border-color: color-mix(in srgb, var(--primary-color) 45%, transparent);
				background: color-mix(in srgb, var(--primary-soft) 28%, transparent);
				transform: translateY(-2px);
			}

			.tag-list a .c {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--text-secondary);
				opacity: 0.7;
			}

			.tag-list a:hover .c {
				color: var(--primary-color);
				opacity: 1;
			}

			/* 右侧小工具列 */
			.side {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			/* 随便逛逛 */
			.explore-desc {
				font-size: 0.85rem;
				line-height: 1.6;
				color: var(--text-secondary);
				margin: 0 0 0.9rem;
			}

			.random-btn {
				width: 100%;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				font-family: var(--font-body);
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--on-accent);
				background: linear-gradient(100deg, var(--primary-color), var(--primary-2));
				border: none;
				border-radius: 9px;
				padding: 0.75rem 1rem;
				cursor: pointer;
				box-shadow: var(--glow-sm);
				transition:
					filter 0.2s ease,
					transform 0.15s ease;
			}

			.random-btn:hover {
				filter: brightness(1.06);
			}

			.random-btn:active {
				transform: scale(0.97);
			}

			/* 外观切换器 */
			.accent-row {
				display: flex;
				gap: 0.7rem;
				margin-top: 0.2rem;
			}

			.accent-dot {
				width: 30px;
				height: 30px;
				border-radius: 50%;
				border: 2px solid var(--border-color);
				cursor: pointer;
				padding: 0;
				position: relative;
				transition:
					transform 0.15s ease,
					border-color 0.2s ease;
			}

			.accent-dot:hover {
				transform: scale(1.12);
			}

			.accent-dot[aria-pressed='true'] {
				border-color: var(--text-main);
			}

			.accent-dot[aria-pressed='true']::after {
				content: "";
				position: absolute;
				inset: -7px;
				border-radius: 50%;
				border: 2px solid currentColor;
			}

			.accent-dot.cyan {
				background: #0ea5e9;
				color: #0ea5e9;
			}
			.accent-dot.violet {
				background: #6366f1;
				color: #6366f1;
			}
			.accent-dot.green {
				background: #10b981;
				color: #10b981;
			}
			.accent-dot.amber {
				background: #f59e0b;
				color: #f59e0b;
			}

			/* 卡片网格由 PostGrid 组件统一管理 */
			@media (max-width: 600px) {
				main {
					padding-top: 2.5rem;
				}
				.page-head h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>文章</h1>
				<p>技术笔记与思考合集。</p>
			</header>

			<!-- 工具区：标签筛选 + 随便逛逛 + 外观 -->
			<section class="tools">
				<div class="panel">
					<div class="panel-title">
						<span class="t">热门标签</span>
						<span class="hint">点选查看该标签下的文章</span>
					</div>
					<div class="tag-list">
						{
							tags.map((t) => (
								<a href={`/tags/${encodeURIComponent(t.name)}/`}>
									{t.name}
									<span class="c">{t.count}</span>
								</a>
							))
						}
					</div>
				</div>

				<div class="side">
					<div class="panel">
						<div class="panel-title">
							<span class="t">随便逛逛</span>
						</div>
						<p class="explore-desc">不想挑？点一下，随机跳到一篇，说不定有惊喜。</p>
						<button class="random-btn" id="random-post" data-links={JSON.stringify(allLinks)}>
							🎲 随机读一篇
						</button>
					</div>

					<div class="panel">
						<div class="panel-title">
							<span class="t">外观</span>
							<span class="hint">当前配色已保存</span>
						</div>
						<div class="accent-row" id="accent-row">
							<button class="accent-dot cyan" data-accent="cyan" aria-label="青蓝" aria-pressed="true"></button>
							<button class="accent-dot violet" data-accent="violet" aria-label="紫" aria-pressed="false"></button>
							<button class="accent-dot green" data-accent="green" aria-label="绿" aria-pressed="false"></button>
							<button class="accent-dot amber" data-accent="amber" aria-label="橙" aria-pressed="false"></button>
						</div>
					</div>
				</div>
			</section>

			<PostGrid posts={posts} />
			<Pagination current={1} last={last} baseHref="/blog/page/" firstHref="/blog/" />
		</main>
		<Footer />

		<script>
			// 随机文章
			const randomBtn = document.getElementById('random-post') as HTMLButtonElement | null;
			randomBtn?.addEventListener('click', () => {
				const links = JSON.parse(randomBtn.dataset.links || '[]') as string[];
				if (links.length) {
					window.location.href = links[Math.floor(Math.random() * links.length)];
				}
			});

			// 主题色切换（存 localStorage，作用于 <html data-accent>）
			const ACCENTS = ['cyan', 'violet', 'green', 'amber'];
			const row = document.getElementById('accent-row');
			const applyAccent = (accent: string) => {
				if (accent === 'cyan') {
					document.documentElement.removeAttribute('data-accent');
				} else {
					document.documentElement.setAttribute('data-accent', accent);
				}
				row?.querySelectorAll('.accent-dot').forEach((dot) => {
					const el = dot as HTMLButtonElement;
					el.setAttribute('aria-pressed', String(el.dataset.accent === accent));
				});
				try {
					localStorage.setItem('site-accent', accent);
				} catch {}
			};
			row?.querySelectorAll('.accent-dot').forEach((dot) => {
				dot.addEventListener('click', () => applyAccent((dot as HTMLElement).dataset.accent || 'cyan'));
			});
			try {
				const saved = localStorage.getItem('site-accent');
				if (saved && ACCENTS.includes(saved)) applyAccent(saved);
			} catch {}
		</script>
	</body>
</html>
