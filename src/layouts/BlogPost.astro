---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime?: string;
	prev?: CollectionEntry<'blog'> | null;
	next?: CollectionEntry<'blog'> | null;
	related?: CollectionEntry<'blog'>[];
	tags?: string[];
	series?: string | null;
	order?: number | null;
	headings?: { depth: number; text: string; slug: string }[];
};

const { title, description, pubDate, updatedDate, heroImage, readingTime, prev, next, related = [], tags = [], series = null, order = null, theme = '随笔', headings = [] } = Astro.props;

const slug = Astro.url.pathname.split('/').filter(Boolean)[1] ?? '';
const ogImage = `/og/${slug}`;

const publishedISO = pubDate.toISOString();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: description,
	datePublished: publishedISO,
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: 'Wang' },
	publisher: { '@type': 'Organization', name: "Wang's Notes" },
	mainEntityOfPage: Astro.url.toString(),
	image: new URL(ogImage, Astro.site).toString(),
};
---

<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			ogImage={ogImage}
			ogType="article"
			publishedTime={publishedISO}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			main {
				width: 100%;
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 2.5rem 1.25rem 1rem;
			}

			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 0.85rem;
				font-weight: 500;
				color: var(--text-secondary);
				text-decoration: none;
				margin-bottom: 1.5rem;
				transition: color 0.2s ease;
			}

			.back-link:hover {
				color: var(--primary-color);
			}

			.prose {
				max-width: var(--content-width);
				margin: 0 auto;
			}

			/* 文章标题渐变文字，增强科技感 */
			.prose h1 {
				background: linear-gradient(
					100deg,
					var(--text-main) 0%,
					var(--text-main) 35%,
					var(--primary-color) 78%,
					var(--primary-2) 100%
				);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				-webkit-text-fill-color: transparent;
			}

			.post-header {
				margin-bottom: 1.5rem;
			}

			.hero-image {
				width: 100%;
				margin: 0 0 2rem;
			}

			.hero-image img {
				display: block;
				width: 100%;
				max-height: 360px;
				object-fit: cover;
				border-radius: 12px;
				border: 1px solid var(--border-color);
			}

			.series {
				display: inline-block;
				margin: 0 0 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.06em;
				color: var(--primary-color);
				text-decoration: none;
				transition: opacity 0.2s ease;
			}

			.series:hover {
				opacity: 0.7;
				text-decoration: underline;
			}

			.theme-label {
				display: inline-block;
				margin: 0 0 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.04em;
				text-decoration: none;
				color: var(--primary-color);
			}

			.theme-label:hover {
				text-decoration: underline;
			}

			.post-header h1 {
				margin: 0;
				font-size: 2.2rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				line-height: 1.25;
				color: var(--text-main);
			}

			.lead {
				margin: 0.8rem 0 0;
				font-size: 1.05rem;
				line-height: 1.65;
				color: var(--text-secondary);
				max-width: 38rem;
			}

			.meta-row {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem 1rem;
				margin-top: 1.1rem;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}

			.tag {
				font-size: 0.72rem;
				font-family: var(--font-mono);
				color: var(--text-secondary);
				text-decoration: none;
				padding: 0.15rem 0.55rem;
				border: 1px solid var(--border-color);
				border-radius: 4px;
				transition: border-color 0.2s ease, color 0.2s ease;
			}

			.tag:hover {
				border-color: var(--primary-color);
				color: var(--primary-color);
			}

			.meta-info {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--text-secondary);
			}

			.meta-info .dot {
				margin: 0 0.35rem;
				opacity: 0.6;
			}

			.last-updated-on {
				font-style: italic;
				color: var(--text-secondary);
				font-size: 0.85rem;
				margin-left: 0.4rem;
			}

			.share {
				margin: 0;
			}

			.share a {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				color: var(--primary-color);
				font-size: 0.85rem;
				text-decoration: none;
				transition: opacity 0.2s ease;
			}

			.share a:hover {
				opacity: 0.72;
			}

			.share svg {
				width: 14px;
				height: 14px;
				fill: currentColor;
			}

			.divider {
				width: 100%;
				height: 1px;
				margin: 1.5rem 0 0;
				border: none;
				background: var(--border-color);
			}

			/* 代码块复制按钮 */
			.prose :global(pre) {
				position: relative;
			}

			.copy-btn {
				position: absolute;
				top: 0.6rem;
				right: 0.6rem;
				z-index: 2;
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				padding: 0.25rem 0.55rem;
				font-size: 0.72rem;
				font-family: var(--font-mono);
				color: var(--text-secondary);
				background: color-mix(in srgb, var(--surface) 85%, transparent);
				border: 1px solid var(--border-color);
				border-radius: 5px;
				cursor: pointer;
				opacity: 0;
				transition: opacity 0.2s ease, color 0.2s ease, border-color 0.2s ease;
			}

			.prose :global(pre):hover .copy-btn {
				opacity: 1;
			}

			.copy-btn:hover {
				color: var(--primary-color);
				border-color: var(--primary-color);
			}

			.copy-btn.copied {
				color: var(--primary-color);
				border-color: var(--primary-color);
			}

			/* AI 生成声明 */
			.ai-byline {
				margin: 2.5rem 0 0;
				padding-top: 1.2rem;
				border-top: 1px solid var(--border-color);
				text-align: center;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.05em;
				color: var(--text-secondary);
			}

			/* 文章末尾 CTA */
			.post-cta {
				margin: 1.5rem 0 0;
				padding: 0.9rem 1.1rem;
				background: var(--code-bg);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				text-align: center;
			}

			.post-cta p {
				margin: 0;
				font-size: 0.9rem;
				line-height: 1.6;
				color: var(--text-secondary);
			}

			.post-cta a {
				color: var(--primary-color);
				text-decoration: none;
				font-weight: 600;
			}

			.post-cta a:hover {
				text-decoration: underline;
				color: var(--primary-color);
				box-shadow: none;
			}

			/* 目录：宽屏右侧 sticky 栏，窄屏内联折叠 */
			.layout {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 220px;
				gap: 2.5rem;
				align-items: start;
				max-width: var(--wide-width);
				margin: 0 auto;
			}

			.toc-rail {
				position: sticky;
				top: 5.5rem;
				max-height: calc(100vh - 6.5rem);
				overflow-y: auto;
				padding: 0.2rem 0;
			}

			.toc-rail .toc-title {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin: 0 0 0.7rem;
			}

			.toc-rail nav {
				display: flex;
				flex-direction: column;
				gap: 0.1rem;
				border-left: 2px solid var(--border-color);
			}

			.toc-rail a {
				font-size: 0.82rem;
				line-height: 1.45;
				color: var(--text-secondary);
				text-decoration: none;
				padding: 0.28rem 0 0.28rem 0.85rem;
				margin-left: -2px;
				border-left: 2px solid transparent;
				transition: color 0.18s ease, border-color 0.18s ease;
			}

			.toc-rail a:hover { color: var(--primary-color); }

			.toc-rail a.active {
				color: var(--primary-color);
				border-left-color: var(--primary-color);
				font-weight: 600;
			}

			.toc-rail a.sub {
				padding-left: 1.7rem;
				font-size: 0.78rem;
			}

			/* 窄屏：内联折叠目录 */
			.toc-inline {
				margin: 1.2rem 0 2rem;
				padding: 0.85rem 1.1rem;
				background: var(--code-bg);
				border: 1px solid var(--border-color);
				border-radius: 8px;
			}

			.toc-inline summary {
				font-family: var(--font-display);
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--text-main);
				cursor: pointer;
				list-style: none;
			}

			.toc-inline summary::-webkit-details-marker { display: none; }

			.toc-inline summary::before {
				content: '§';
				margin-right: 0.5rem;
				color: var(--primary-color);
				font-family: var(--font-mono);
			}

			.toc-inline nav {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
				margin-top: 0.6rem;
				padding-left: 0.3rem;
				border-left: 2px solid var(--border-color);
			}

			.toc-inline a {
				font-size: 0.88rem;
				line-height: 1.5;
				color: var(--text-secondary);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.toc-inline a:hover { color: var(--primary-color); }
			.toc-inline a.sub { padding-left: 1.2rem; font-size: 0.82rem; }

			@media (max-width: 1000px) {
				.layout { display: block; }
				.toc-rail { display: none; }
			}

			@media (min-width: 1001px) {
				.toc-inline { display: none; }
			}

			/* 代码块语言标签 */
			.prose :global(pre[data-lang])::before {
				content: attr(data-lang);
				position: absolute;
				top: 0.5rem;
				left: 0.75rem;
				z-index: 1;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.04em;
				color: var(--text-secondary);
				opacity: 0.5;
			}

			.prose :global(pre[data-lang]) {
				padding-top: 1.8rem;
			}

			/* 回到顶部 */
			.back-to-top {
				position: fixed;
				bottom: 1.5rem;
				right: 1.5rem;
				z-index: 20;
				width: 36px;
				height: 36px;
				border-radius: 50%;
				border: 1px solid var(--border-color);
				background: var(--surface);
				color: var(--text-secondary);
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0;
				visibility: hidden;
				transform: translateY(8px);
				transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease, color 0.2s ease, border-color 0.2s ease;
				box-shadow: var(--shadow-sm);
			}

			.back-to-top:hover {
				color: var(--primary-color);
				border-color: var(--primary-color);
			}

			.back-to-top.visible {
				opacity: 1;
				visibility: visible;
				transform: translateY(0);
			}

			/* 上一篇 / 下一篇 */
			.pager {
				max-width: var(--content-width);
				margin: 2.5rem auto 0;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
			}

			.pager a {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				padding: 0.9rem 1rem;
				border: 1px solid var(--border-color);
				border-radius: 10px;
				text-decoration: none;
				color: var(--text-main);
				transition: border-color 0.2s ease;
			}

			.pager a:hover {
				border-color: var(--primary-color);
			}

			.pager .dir {
				font-size: 0.72rem;
				font-family: var(--font-mono);
				color: var(--primary-color);
				letter-spacing: 0.05em;
			}

			.pager .pt {
				font-size: 0.9rem;
				font-weight: 600;
				line-height: 1.4;
			}

			.pager .next {
				text-align: right;
			}

			.pager .empty {
				border: none;
				background: none;
				pointer-events: none;
			}

			/* 相关阅读 */
			.related {
				max-width: var(--wide-width);
				margin: 3rem auto 0;
			}

			.related h2 {
				font-size: 1.15rem;
				margin: 0 0 1rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.related h2::before {
				content: '';
				width: 3px;
				height: 1.05rem;
				border-radius: 2px;
				background: linear-gradient(180deg, var(--primary-color), var(--primary-2));
			}

			.related-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
			}

			.related-card {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				padding: 1rem 1.1rem;
				border: 1px solid var(--border-color);
				border-radius: 10px;
				text-decoration: none;
				color: var(--text-main);
				background: var(--surface);
				transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
			}

			.related-card:hover {
				border-color: color-mix(in srgb, var(--primary-color) 50%, transparent);
				transform: translateY(-3px);
				box-shadow: var(--glow-sm);
			}

			.related-card .rc-title {
				font-size: 0.95rem;
				font-weight: 600;
				line-height: 1.45;
				color: var(--text-main);
			}

			.related-card .rc-excerpt {
				font-size: 0.82rem;
				line-height: 1.55;
				color: var(--text-secondary);
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.related-card .rc-meta {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--text-secondary);
				margin-top: auto;
			}

			@media (max-width: 1000px) {
				.related-grid { grid-template-columns: 1fr; }
			}

			@media (max-width: 600px) {
				.pager {
					grid-template-columns: 1fr;
				}
				.pager .next {
					text-align: left;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<a class="back-link" href="/blog">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M15 18l-6-6 6-6" />
					</svg>
					返回文章
				</a>

				<div class="layout">
				<div class="prose">
					<div class="post-header">
						<div class="hero-image">
							{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
						</div>
					<div class="head-text">
						{
							theme && (
								<a class="theme-label" href={`/themes/${encodeURIComponent(theme)}/`}>
									{theme}
								</a>
							)
						}
						{
							series && (
								<a class="series" href={`/series/${encodeURIComponent(series)}/`}>
									{series}{order != null && ` · 第 ${order} 篇`}
								</a>
							)
						}
							<h1>{title}</h1>
							{description && <p class="lead">{description}</p>}
							<div class="meta-row">
								{
									tags.length > 0 && (
										<div class="tags">
											{tags.map((t) => (
												<a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>
											))}
										</div>
									)
								}
								<span class="meta-info">
									<FormattedDate date={pubDate} />
									{
										updatedDate && (
											<span class="last-updated-on">
												· 最后更新于 <FormattedDate date={updatedDate} />
											</span>
										)
									}
									{readingTime && <span class="dot">·</span>}
									{readingTime && <span>{readingTime}</span>}
								</span>
								<div class="share">
									<a
										href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url)}&text=${encodeURIComponent(title)}`}
										target="_blank"
										rel="noopener noreferrer"
									>
										<svg viewBox="0 0 24 24" aria-hidden="true"
											><path
												d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
											></path></svg
										>
										<span>分享到 X</span>
									</a>
								</div>
							</div>
						</div>
					<hr class="divider" />
				</div>

				{
					headings.length > 1 && (
						<details class="toc-inline">
							<summary>目录</summary>
							<nav>
								{headings.map((h) => (
									<a href={`#${h.slug}`} class={h.depth === 3 ? 'sub' : ''}>{h.text}</a>
								))}
							</nav>
						</details>
					)
				}

				<slot />
				<p class="ai-byline">人工智能生成 · 人机协同创造</p>

				<div class="post-cta">
					<p>如果这篇对你有启发，欢迎 <a href="https://twitter.com/intent/tweet?url={encodeURIComponent(Astro.url)}&text={encodeURIComponent(title)}" target="_blank" rel="noopener noreferrer">分享到 X</a>，或 <a href="/blog">浏览更多文章</a>。</p>
				</div>
			</div>

				{
					headings.length > 1 && (
						<aside class="toc-rail" aria-label="目录">
							<p class="toc-title">本文目录</p>
							<nav id="toc-nav">
								{headings.map((h) => (
									<a href={`#${h.slug}`} data-slug={h.slug} class={h.depth === 3 ? 'sub' : ''}>{h.text}</a>
								))}
							</nav>
						</aside>
					)
				}
				</div>

				<nav class="pager" aria-label="文章导航">
					{
						prev ? (
							<a class="prev" href={`/blog/${prev.id}/`}>
								<span class="dir">← 上一篇</span>
								<span class="pt">{prev.data.title}</span>
							</a>
						) : (
							<span class="empty" />
						)
					}
					{
						next ? (
							<a class="next" href={`/blog/${next.id}/`}>
								<span class="dir">下一篇 →</span>
								<span class="pt">{next.data.title}</span>
							</a>
						) : (
							<span class="empty" />
						)
					}
				</nav>

				{
					related.length > 0 && (
						<section class="related" aria-label="相关阅读">
							<h2>相关阅读</h2>
							<div class="related-grid">
								{related.map((p) => (
									<a class="related-card" href={`/blog/${p.id}/`}>
										<span class="rc-title">{p.data.title}</span>
										{p.data.description && <p class="rc-excerpt">{p.data.description}</p>}
										<span class="rc-meta">
											{p.data.theme}
											<span class="dot"> · </span>
											<FormattedDate date={p.data.pubDate} />
										</span>
									</a>
								))}
							</div>
						</section>
					)
				}
			</article>
		</main>

		<button class="back-to-top" id="back-to-top" aria-label="回到顶部" type="button">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M18 15l-6-6-6 6"/>
			</svg>
		</button>

		<Footer />

		<script>
			// 目录滚动高亮（scroll-spy）
			const tocLinks = Array.from(
				document.querySelectorAll('#toc-nav a')
			) as HTMLAnchorElement[];
			if (tocLinks.length) {
				const map = new Map<string, HTMLAnchorElement>();
				tocLinks.forEach((a) => map.set(a.dataset.slug || '', a));
				const targets = tocLinks
					.map((a) => document.getElementById(a.dataset.slug || ''))
					.filter((el): el is HTMLElement => !!el);
				const setActive = (slug: string) => {
					tocLinks.forEach((a) => a.classList.toggle('active', a.dataset.slug === slug));
				};
				const observer = new IntersectionObserver(
					(entries) => {
						const visible = entries
							.filter((e) => e.isIntersecting)
							.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
						if (visible[0]) setActive(visible[0].target.id);
					},
					{ rootMargin: '-15% 0px -70% 0px', threshold: 0 }
				);
				targets.forEach((t) => observer.observe(t));
				// 点击平滑滚动并高亮
				tocLinks.forEach((a) => {
					a.addEventListener('click', () => {
						setActive(a.dataset.slug || '');
					});
				});
			}

			// 代码块复制按钮
			document.querySelectorAll('pre').forEach((pre) => {
				const btn = document.createElement('button');
				btn.className = 'copy-btn';
				btn.type = 'button';
				btn.textContent = '复制';
				btn.addEventListener('click', async () => {
					const code = pre.querySelector('code')?.innerText ?? pre.innerText;
					try {
						await navigator.clipboard.writeText(code);
						btn.textContent = '已复制';
						btn.classList.add('copied');
						setTimeout(() => {
							btn.textContent = '复制';
							btn.classList.remove('copied');
						}, 1500);
					} catch {
						btn.textContent = '失败';
					}
				});
				pre.appendChild(btn);
			});

			// 回到顶部按钮
			const backToTop = document.getElementById('back-to-top');
			if (backToTop) {
				document.addEventListener('scroll', () => {
					backToTop.classList.toggle('visible', document.documentElement.scrollTop > 400);
				}, { passive: true });
				backToTop.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
			}

			// 代码块语言标签
			document.querySelectorAll('pre[class*="language-"]').forEach((pre) => {
				const cls = pre.className.match(/language-(\w+)/);
				if (cls) pre.setAttribute('data-lang', cls[1]);
			});

			// 代码块折叠
			document.querySelectorAll('.prose pre').forEach((pre) => {
				const cls = pre.className.match(/language-(\w+)/);
				const lang = cls ? cls[1] : 'code';
				const lines = (pre.innerText.match(/\n/g) || []).length + 1;
				const wrap = document.createElement('details');
				wrap.className = 'code-fold';
				const summary = document.createElement('summary');
				summary.innerHTML = `<span class="lbl">代码 · ${lang}</span><span class="chev">展开</span>`;
				pre.replaceWith(wrap);
				wrap.appendChild(summary);
				wrap.appendChild(pre);
				if (lines <= 4) wrap.open = true;
				const chev = summary.querySelector('.chev');
				chev.textContent = wrap.open ? '收起' : '展开';
				summary.addEventListener('toggle', () => {
					chev.textContent = wrap.open ? '收起' : '展开';
				});
			});

			// 鼠标聚光演示
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.querySelectorAll('.spotlight-demo').forEach((box) => {
					let raf = 0;
					box.addEventListener('pointermove', (e) => {
						const r = box.getBoundingClientRect();
						const x = e.clientX - r.left;
						const y = e.clientY - r.top;
						if (!raf) raf = requestAnimationFrame(() => {
							box.style.setProperty('--mx', x + 'px');
							box.style.setProperty('--my', y + 'px');
							raf = 0;
						});
					});
				});
			}
		</script>
	</body>
</html>
