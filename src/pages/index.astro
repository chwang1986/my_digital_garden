---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { readingTime } from '../utils/reading-time';
import { sortPosts } from '../utils/sort-posts';
import { notes } from '../data/notes';

const posts = sortPosts(await getCollection('blog'));
const [featured, ...rest] = posts;
// 首页只突出最近文章：头条 1 篇 + 下方精简列表 3 篇
const recent = rest.slice(0, 3);

// 本周随想：取日期最新的一条
const latestNote = [...notes].sort((a, b) => (a.date < b.date ? 1 : -1))[0] ?? null;

// 主题 / 系列计数
const themeCounts = new Map<string, number>();
const seriesCounts = new Map<string, number>();
for (const post of posts) {
	const t = post.data.theme || '随笔';
	themeCounts.set(t, (themeCounts.get(t) ?? 0) + 1);
	if (post.data.series) seriesCounts.set(post.data.series, (seriesCounts.get(post.data.series) ?? 0) + 1);
}
const themes = [...themeCounts.entries()]
	.map(([name, count]) => ({ name, count }))
	.sort((a, b) => b.count - a.count);
const seriesList = [...seriesCounts.entries()]
	.map(([name, count]) => ({ name, count }))
	.sort((a, b) => b.count - a.count);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 1.25rem;
			}

			/* ===== Hero：聚焦文字，弱化装饰 ===== */
			.hero {
				position: relative;
				padding: 4rem 0 3rem;
				border-bottom: 1px solid var(--border-color);
			}

			.hero-kicker {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 500;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin: 0 0 1.4rem;
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
			}

			.hero-kicker .pulse {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: var(--primary-color);
				box-shadow: 0 0 0 0 var(--glow);
				animation: pulse 2.2s ease-out infinite;
			}

			@keyframes pulse {
				0% {
					box-shadow: 0 0 0 0 var(--glow);
				}
				70% {
					box-shadow: 0 0 0 7px transparent;
				}
				100% {
					box-shadow: 0 0 0 0 transparent;
				}
			}

			.hero-title {
				font-size: 3.2rem;
				font-weight: 800;
				line-height: 1.12;
				letter-spacing: -0.025em;
				margin: 0 0 1.2rem;
				color: var(--text-main);
				max-width: 16ch;
			}

			.hero-lede {
				font-size: 1.15rem;
				line-height: 1.7;
				color: var(--text-secondary);
				margin: 0;
				max-width: 34rem;
			}

			/* ===== 头条（最新一篇，做主角） ===== */
			.featured {
				padding: 2.75rem 0 1rem;
			}

			.featured-link {
				position: relative;
				display: block;
				text-decoration: none;
				color: var(--text-main);
				border-radius: 16px;
				border: 1px solid var(--border-color);
				background: var(--surface);
				transition:
					transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
					box-shadow 0.28s ease,
					border-color 0.28s ease;
			}

			.featured-link::after {
				content: "";
				position: absolute;
				inset: -1px;
				border-radius: inherit;
				padding: 1px;
				background: linear-gradient(
					120deg,
					transparent 30%,
					var(--primary-color),
					var(--primary-2),
					transparent 70%
				);
				background-size: 220% 220%;
				-webkit-mask:
					linear-gradient(#fff 0 0) content-box,
					linear-gradient(#fff 0 0);
				-webkit-mask-composite: xor;
				mask-composite: exclude;
				opacity: 0;
				transition: opacity 0.3s ease;
				pointer-events: none;
			}

			.featured-link:hover {
				transform: translateY(-3px);
				box-shadow: var(--glow-sm);
				border-color: transparent;
			}

			.featured-link:hover::after {
				opacity: 1;
				animation: border-flow 2.4s linear infinite;
			}

			@keyframes border-flow {
				0% {
					background-position: 0% 50%;
				}
				100% {
					background-position: 220% 50%;
				}
			}

			.featured-body {
				padding: 1.8rem 1.9rem 2rem;
			}

			.featured-tag {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin: 0 0 0.8rem;
			}

			.featured-tag::before {
				content: "";
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--primary-color);
			}

			.featured-title {
				font-size: 2.3rem;
				font-weight: 800;
				line-height: 1.25;
				letter-spacing: -0.02em;
				margin: 0 0 0.8rem;
				color: var(--text-main);
				background: linear-gradient(
					100deg,
					var(--text-main) 0%,
					var(--text-main) 55%,
					var(--primary-strong) 100%
				);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
				-webkit-text-fill-color: transparent;
			}

			.featured-excerpt {
				font-size: 1.08rem;
				line-height: 1.8;
				color: var(--text-secondary);
				margin: 0 0 1.2rem;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.featured-date {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--text-secondary);
			}

			.featured-date .dot {
				margin: 0 0.4rem;
				opacity: 0.6;
			}

			/* ===== 本周随想：轻量真人感入口 ===== */
			.note {
				padding: 2.25rem 0 0.5rem;
			}

			.note-card {
				position: relative;
				border: 1px solid var(--border-color);
				border-radius: 14px;
				background: var(--surface);
				padding: 1.4rem 1.5rem 1.3rem 1.7rem;
				border-left: 3px solid var(--primary-2);
			}

			.note-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.5rem;
				margin-bottom: 0.7rem;
			}

			.note-label {
				font-family: var(--font-mono);
				font-size: 0.74rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--primary-2);
				margin: 0;
			}

			.note-date {
				font-family: var(--font-mono);
				font-size: 0.74rem;
				color: var(--text-secondary);
			}

			.note-text {
				margin: 0 0 0.8rem;
				font-size: 1.02rem;
				line-height: 1.75;
				color: var(--text-main);
			}

			.note-more {
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--primary-2);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.note-more:hover {
				color: var(--primary-strong);
			}

			/* ===== 最近文章：单列精简列表，突出标题 ===== */
			.recent-posts {
				padding: 2.75rem 0 1rem;
			}

			.recent-posts-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.4rem;
			}

			.recent-posts-head h2 {
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--primary-color);
				margin: 0;
			}

			.recent-posts-head .view-all {
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--text-secondary);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.recent-posts-head .view-all:hover {
				color: var(--primary-color);
			}

			/* 列表项：大标题 + 弱元信息，悬停左侧色条 + 标题变色 */
			.post-row {
				display: block;
				text-decoration: none;
				color: var(--text-main);
				padding: 1.4rem 0 1.4rem 1.2rem;
				border-left: 2px solid transparent;
				border-bottom: 1px solid var(--border-color);
				transition: border-color 0.2s ease, padding-left 0.2s ease;
			}

			.post-row:last-child {
				border-bottom: none;
			}

			.post-row:hover {
				border-left-color: var(--primary-color);
				padding-left: 1.4rem;
			}

			.post-row-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--text-secondary);
				margin-bottom: 0.4rem;
			}

			.post-row-meta .theme-tag {
				color: var(--primary-color);
			}

			.post-row-title {
				font-size: 1.5rem;
				font-weight: 700;
				line-height: 1.4;
				letter-spacing: -0.01em;
				margin: 0 0 0.45rem;
				color: var(--text-main);
				transition: color 0.2s ease;
			}

			.post-row:hover .post-row-title {
				color: var(--primary-color);
			}

			.post-row-excerpt {
				font-size: 1rem;
				line-height: 1.75;
				color: var(--text-secondary);
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* ===== 按主题/系列浏览 ===== */
			.browse {
				padding: 2.5rem 0 1rem;
				margin-top: 1rem;
				border-top: 1px solid var(--border-color);
			}

			.browse-group + .browse-group {
				margin-top: 1.5rem;
			}

			.browse-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1rem;
			}

			.browse-head h2 {
				font-size: 0.8rem;
				font-weight: 600;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text-secondary);
				margin: 0;
			}

			.browse-head .view-all {
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--primary-color);
				text-decoration: none;
			}

			.browse-head .view-all:hover {
				color: var(--primary-strong);
			}

			.browse-chips {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.chip {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				text-decoration: none;
				font-size: 0.88rem;
				color: var(--text-main);
				padding: 0.4rem 0.8rem;
				border: 1px solid var(--border-color);
				border-radius: 8px;
				background: var(--surface);
				transition:
					border-color 0.2s ease,
					color 0.2s ease,
					transform 0.2s ease,
					box-shadow 0.2s ease;
			}

			.chip:hover {
				border-color: var(--primary-color);
				color: var(--primary-color);
				transform: translateY(-2px);
				box-shadow: var(--glow-sm);
			}

			.chip .count {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--text-secondary);
				background: var(--code-bg);
				padding: 0.05rem 0.4rem;
				border-radius: 4px;
			}

			/* 最近文章列表容器（单列） */
			.post-list {
				display: flex;
				flex-direction: column;
			}

			@media (max-width: 720px) {
				.hero {
					padding: 3rem 0 2.5rem;
				}
				.hero-title {
					font-size: 2.2rem;
				}
				.featured {
					padding: 2rem 0 0.5rem;
				}
				.featured-title {
					font-size: 1.7rem;
				}
				.featured-excerpt {
					font-size: 1rem;
				}
				.post-row-title {
					font-size: 1.3rem;
				}
				.post-row-excerpt {
					font-size: 0.95rem;
				}
			}

			@media (max-width: 480px) {
				.hero-title {
					font-size: 1.7rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="hero-kicker"><span class="pulse"></span>Wang's Notes</p>
				<h1 class="hero-title"><span class="gradient-text">把构建的过程</span>，写成可追溯的笔记。</h1>
				<p class="hero-lede">
					这里收录技术实践、本地 AI 与个人思考。每一篇都来自真实的工程实践，并记录它一路长成的轨迹。
				</p>
			</section>

			{
				featured && (
					<section class="featured">
						<a class="featured-link" href={`/blog/${featured.id}/`}>
							<div class="featured-body">
								<p class="featured-tag">最新发布</p>
								<h2 class="featured-title">{featured.data.title}</h2>
								{featured.data.description && (
									<p class="featured-excerpt">{featured.data.description}</p>
								)}
								<span class="featured-date">
									<FormattedDate date={featured.data.pubDate} />
									<span class="dot">·</span>
									{readingTime(featured.body)}
								</span>
							</div>
						</a>
					</section>
				)
			}

			{
				latestNote && (
					<section class="note">
						<div class="note-card">
							<div class="note-head">
								<p class="note-label">本周随想</p>
								<span class="note-date">{latestNote.date}</span>
							</div>
							<p class="note-text">{latestNote.text}</p>
							<a class="note-more" href="/themes/瞎想/">更多随想 →</a>
						</div>
					</section>
				)
			}

			<section class="recent-posts">
				<div class="recent-posts-head">
					<h2>最近文章</h2>
					<a class="view-all" href="/blog">全部归档 →</a>
				</div>
				<div class="post-list">
					{
						recent.map((post) => (
							<a class="post-row" href={`/blog/${post.id}/`}>
								<div class="post-row-meta">
									{post.data.theme && <span class="theme-tag">{post.data.theme}</span>}
									<span>·</span>
									<FormattedDate date={post.data.pubDate} />
									<span>·</span>
									{readingTime(post.body)}
								</div>
								<h3 class="post-row-title">{post.data.title}</h3>
								{post.data.description && (
									<p class="post-row-excerpt">{post.data.description}</p>
								)}
							</a>
						))
					}
				</div>
			</section>

			<section class="browse">
				<div class="browse-group">
					<div class="browse-head">
						<h2>按主题浏览</h2>
						<a class="view-all" href="/categories">全部分类 →</a>
					</div>
					<div class="browse-chips">
						{
							themes.map((t) => (
								<a class="chip" href={`/themes/${encodeURIComponent(t.name)}/`}>
									{t.name}
									<span class="count">{t.count}</span>
								</a>
							))
						}
					</div>
				</div>
				{
					seriesList.length > 0 && (
						<div class="browse-group">
							<div class="browse-head">
								<h2>按系列浏览</h2>
							</div>
							<div class="browse-chips">
								{
									seriesList.map((s) => (
										<a class="chip" href={`/series/${encodeURIComponent(s.name)}/`}>
											{s.name}
											<span class="count">{s.count}</span>
										</a>
									))
								}
							</div>
						</div>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
