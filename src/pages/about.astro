---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 4.5rem 1.25rem 1rem;
			}

			.hero {
				padding-bottom: 2.5rem;
				margin-bottom: 3rem;
				border-bottom: 1px solid var(--border-color);
			}

			.about-title {
				font-size: 3rem;
				font-weight: 600;
				letter-spacing: -0.02em;
				line-height: 1.15;
				margin: 0 0 1.1rem;
				color: var(--text-main);
			}

			.about-title .accent {
				color: var(--primary-color);
			}

			.about-intro {
				font-size: 1.2rem;
				line-height: 1.85;
				color: var(--text-secondary);
				margin: 0;
				max-width: 38rem;
			}

			.prose {
				max-width: var(--content-width);
				margin: 0 auto;
			}

			.section-title {
				font-size: 1.4rem;
				font-weight: 700;
				color: var(--text-main);
				margin: 2.75rem 0 1rem;
			}

			.section-title:first-child {
				margin-top: 0;
			}

			.lead {
				font-size: 1.1rem;
				line-height: 1.8;
				color: var(--text-secondary);
				margin: 0 0 1.5rem;
			}

			.topics {
				list-style: none;
				padding: 0;
				margin: 0 0 1.5rem;
			}

			.topics li {
				display: flex;
				gap: 0.75rem;
				align-items: baseline;
				padding: 0.6rem 0;
				border-bottom: 1px solid var(--border-color);
				color: var(--text-secondary);
			}

			.topics li:last-child {
				border-bottom: none;
			}

			.topics .t-title {
				color: var(--text-main);
				font-weight: 600;
				flex-shrink: 0;
				min-width: 6.5rem;
			}

			.stack {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin: 0 0 1.5rem;
			}

			.stack span {
				font-family: var(--font-mono);
				font-size: 0.82rem;
				color: var(--text-secondary);
				padding: 0.35rem 0.75rem;
				border: 1px solid var(--border-color);
				border-radius: 999px;
			}

			.find-link {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				color: var(--primary-color);
				text-decoration: none;
				font-weight: 600;
				border: 1px solid var(--primary-color);
				padding: 0.55rem 1.1rem;
				border-radius: 999px;
				transition:
					background 0.2s ease,
					color 0.2s ease;
			}

			.find-link:hover {
				background: var(--primary-color);
				color: var(--on-accent);
			}

			.find-link svg {
				width: 15px;
				height: 15px;
				fill: currentColor;
			}

			@media (max-width: 600px) {
				main {
					padding-top: 3rem;
				}
				.about-title {
					font-size: 2.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1 class="about-title">关于 <span class="accent">Wang's Notes</span></h1>
				<p class="about-intro">
					我是一名工程师，习惯把做过的事、踩过的坑和想通的逻辑写下来。这里是我存放这些文字的地方——一个用
					Astro 构建、内容全部进 Git 的数字花园。
				</p>
			</section>

			<article class="prose">
				<h2 class="section-title">我写什么</h2>
				<p class="lead">
					聚焦在工程实践本身，以及支撑实践的那套思考方式：
				</p>
				<ul class="topics">
					<li><span class="t-title">效率系统</span><span>笔记方法、工具选型，以及如何让知识真正属于自己。</span></li>
					<li><span class="t-title">软件构建</span><span>从选型到部署，记录把想法落地的全过程。</span></li>
					<li><span class="t-title">可追溯性</span><span>用 Git 与版本化思维管理写作、配置与决策。</span></li>
				</ul>

				<h2 class="section-title">技术栈</h2>
				<p class="lead">本站是一套极简静态工程：</p>
				<div class="stack">
					<span>Astro</span>
					<span>TypeScript</span>
					<span>Markdown / MDX</span>
					<span>GitHub</span>
					<span>Vercel</span>
					<span>Push 即部署</span>
				</div>

			<h2 class="section-title">如何找到我</h2>
			<p class="lead">如果你也在折腾笔记、博客或构建工具，欢迎顺着文章里的思路一起聊。</p>
		</article>
		</main>
		<Footer />
	</body>
</html>
