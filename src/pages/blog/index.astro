---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`随笔 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}

			.page-head {
				margin-bottom: 2.5rem;
			}

			.page-head h1 {
				font-size: 2.6rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				margin: 0 0 0.5rem;
				color: var(--text-main);
			}

			.page-head p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.15rem;
			}

			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.post-item {
				display: flex;
				gap: 1.25rem;
				align-items: stretch;
				padding: 0.9rem;
				border-radius: 16px;
				border: 1px solid transparent;
				text-decoration: none;
				transition:
					background 0.25s ease,
					border-color 0.25s ease,
					transform 0.25s ease;
			}

			.post-item:hover {
				background: color-mix(in srgb, var(--primary-soft) 12%, transparent);
				border-color: color-mix(in srgb, var(--primary-color) 22%, transparent);
				transform: translateY(-2px);
			}

			.post-thumb {
				width: 116px;
				height: 116px;
				flex-shrink: 0;
				border-radius: 12px;
				overflow: hidden;
				background: color-mix(in srgb, var(--primary-soft) 28%, var(--background-body));
			}

			.post-thumb :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.4s ease;
			}

			.post-item:hover .post-thumb :global(img) {
				transform: scale(1.05);
			}

			.post-body {
				flex: 1;
				min-width: 0;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.post-title {
				font-size: 1.15rem;
				font-weight: 650;
				line-height: 1.4;
				margin: 0 0 0.4rem;
				color: var(--text-main);
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-item:hover .post-title {
				color: var(--primary-color);
			}

			.post-excerpt {
				font-size: 0.92rem;
				line-height: 1.55;
				margin: 0 0 0.5rem;
				color: var(--text-secondary);
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-meta {
				font-size: 0.8rem;
				color: var(--text-secondary);
				font-family: var(--font-mono);
				margin-top: auto;
			}

			@media (max-width: 600px) {
				main {
					padding-top: 2.5rem;
				}
				.page-head h1 {
					font-size: 2rem;
				}
				.post-item {
					gap: 0.9rem;
					padding: 0.75rem;
				}
				.post-thumb {
					width: 84px;
					height: 84px;
				}
				.post-title {
					font-size: 1.05rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>随笔</h1>
				<p>技术笔记与思考合集。</p>
			</header>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a class="post-item" href={`/blog/${post.id}/`}>
								<div class="post-thumb">
									{post.data.heroImage && (
										<Image src={post.data.heroImage} alt="" width={232} height={232} />
									)}
								</div>
								<div class="post-body">
									<h3 class="post-title">{post.data.title}</h3>
									{post.data.description && (
										<p class="post-excerpt">{post.data.description}</p>
									)}
									<span class="post-meta">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
