---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Pagination from '../../components/Pagination.astro';
import PostGrid from '../../components/PostGrid.astro';
import { sortPosts } from '../../utils/sort-posts';
import { SITE_TITLE } from '../../consts';

const all = sortPosts(await getCollection('blog'));
const pageSize = 12;
const posts = all.slice(0, pageSize);
const last = Math.max(1, Math.ceil(all.length / pageSize));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`全部文章 - ${SITE_TITLE}`} description="全部文章：标题、主题、时间与标签。" />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}

			.page-head h1 {
				margin: 0 0 0.5rem;
			}

			.page-head p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.05rem;
			}

			/* 卡片网格由 PostGrid 组件统一管理 */
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<a class="back" href="/themes">← 按主题浏览</a>
				<h1>全部文章</h1>
				<p>标题、主题、时间与标签，一张清单看全部。</p>
			</header>
			<PostGrid posts={posts} />
			<Pagination current={1} last={last} baseHref="/posts/page/" firstHref="/posts/" />
		</main>
		<Footer />
	</body>
</html>
