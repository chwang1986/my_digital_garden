---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const p of posts) {
	if (p.data.theme) counts.set(p.data.theme, (counts.get(p.data.theme) ?? 0) + 1);
}

// 主题一句话描述（人工维护，覆盖本站现有主题；未见过的主题回退到默认文案）
const themeDesc: Record<string, string> = {
	'ollama的使用': '在本地把大模型跑起来、调顺手的一整套实操笔记。',
	'自建blog平台': '从零搭起这个 Astro 博客的过程、决策与踩过的坑。',
	'Mac 新手笔记': 'macOS 上手、软件、快捷键与日常使用技巧。',
	'瞎想': '随手记下的想法、观察与一点不成熟的碎碎念。',
	'与AI对话': '怎么和 AI 协作、写提示词、把专业内容讲给外行听。',
	'写作方法': '把复杂的东西拆清楚、写明白的一些方法。',
	'历史故事': '从史记和典故里翻出来的故事与人物。',
};
const fallbackDesc = '这一类下的文章合集，点进去看看。';

const themes = [...counts.entries()]
	.map(([name, n]) => ({ name, n, desc: themeDesc[name] ?? fallbackDesc }))
	.sort((a, b) => b.n - a.n || a.name.localeCompare(b.name, 'zh'));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`主题 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}
			.page-head {
				margin-bottom: 2rem;
			}
			.page-head h1 {
				font-size: 2.2rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				margin: 0 0 0.5rem;
			}
			.page-head p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.15rem;
			}
			/* 知识地图：每行一个主题条目 */
			.map {
				display: flex;
				flex-direction: column;
				gap: 0.9rem;
			}
			.map-item {
				display: flex;
				align-items: center;
				gap: 1rem;
				text-decoration: none;
				color: inherit;
				border: 1px solid var(--border-color);
				border-radius: 12px;
				background: var(--surface);
				padding: 1rem 1.2rem;
				border-left: 3px solid var(--primary-color);
				transition:
					border-color 0.2s ease,
					transform 0.15s ease,
					box-shadow 0.2s ease;
			}
			.map-item:hover {
				border-color: color-mix(in srgb, var(--primary-color) 45%, transparent);
				transform: translateY(-2px);
				box-shadow: var(--glow-sm);
			}
			.map-item:nth-child(even) {
				background: color-mix(in srgb, var(--primary-soft) 12%, var(--surface));
				border-left-color: var(--primary-2);
			}
			.map-no {
				flex: none;
				font-family: var(--font-mono);
				font-size: 0.8rem;
				font-weight: 700;
				color: var(--on-accent);
				background: linear-gradient(120deg, var(--primary-color), var(--primary-2));
				border-radius: 7px;
				padding: 0.2rem 0.5rem;
			}
			.map-body {
				flex: 1;
				min-width: 0;
			}
			.map-name {
				font-size: 1.05rem;
				font-weight: 700;
				margin: 0 0 0.2rem;
			}
			.map-desc {
				margin: 0;
				font-size: 0.86rem;
				color: var(--text-secondary);
				line-height: 1.45;
			}
			.map-count {
				flex: none;
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--text-secondary);
				white-space: nowrap;
			}
			.map-count b {
				color: var(--primary-color);
				font-size: 1.1rem;
			}
			.all-link {
				margin-top: 2.2rem;
				font-size: 0.95rem;
			}
			.all-link a {
				color: var(--primary-color);
				text-decoration: none;
				border-bottom: 1px solid color-mix(in srgb, var(--primary-color) 40%, transparent);
				padding-bottom: 1px;
				transition: border-color 0.2s ease;
			}
			.all-link a:hover {
				border-color: var(--primary-color);
			}
			@media (max-width: 600px) {
				.page-head h1 { font-size: 2rem; }
				.map-item { flex-wrap: wrap; gap: 0.6rem; }
				.map-count { width: 100%; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>主题地图</h1>
				<p>按主题归类，每个主题一句话说明，点进去看该主题下的全部文章。</p>
			</header>
			{
				themes.length > 0 ? (
					<div class="map">
						{themes.map((t, i) => (
							<a class="map-item" href={`/themes/${encodeURIComponent(t.name)}/`}>
								<span class="map-no">{String(i + 1).padStart(2, '0')}</span>
								<span class="map-body">
									<p class="map-name">{t.name}</p>
									<p class="map-desc">{t.desc}</p>
								</span>
								<span class="map-count"><b>{t.n}</b> 篇</span>
							</a>
						))}
					</div>
				) : (
					<p>还没有主题。</p>
				)
			}
			<p class="all-link">
				<a href="/posts">查看全部文章（标题 · 主题 · 时间 · 标签）→</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
