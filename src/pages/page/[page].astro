---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { sortPosts } from '../../utils/sort-posts';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths({ paginate }) {
	const all = sortPosts(await getCollection('blog'));
	// 第 1 页是首页（/），这里只生成第 2 页起的续页
	return paginate(all, { pageSize: 12 }).slice(1);
}

const page = Astro.props.page;
const posts = page.data;
const current = page.current;
const last = page.last;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`全部文章 - 第 ${current} 页 - ${SITE_TITLE}`} description="全部文章。" />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}

			.page-head {
				margin-bottom: 2.5rem;
			}

			.page-head h1 {
				font-size: 2.6rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				margin: 0 0 0.5rem;
				color: var(--text-main);
			}

			.page-head p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.15rem;
			}

			.post-list {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
			}

			@media (max-width: 900px) {
				.post-list {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (max-width: 600px) {
				main {
					padding-top: 2.5rem;
				}
				.page-head h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>全部文章</h1>
				<p>第 {current} 页。</p>
			</header>
			<div class="post-list">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
			<Pagination current={current} last={last} baseHref="/page/" firstHref="/" />
		</main>
		<Footer />
	</body>
</html>
