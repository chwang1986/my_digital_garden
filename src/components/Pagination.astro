---
interface Props {
	/** 当前页码（从 1 开始） */
	current: number;
	/** 总页数 */
	last: number;
	/** 分页路径前缀，如 '/blog/page/' */
	baseHref: string;
	/** 第 1 页地址（默认 baseHref）；首页分页时传 '/' 之类 */
	firstHref?: string;
	/** 手动覆盖「上一页」链接（默认按 current/baseHref 推导） */
	prevHref?: string | null;
	/** 手动覆盖「下一页」链接 */
	nextHref?: string | null;
}

const { current, last, baseHref, firstHref, prevHref, nextHref } = Astro.props;

const first = firstHref ?? baseHref;
const pageUrl = (i: number) => (i === 1 ? first : `${baseHref}${i}`);
const derivedPrev = current > 1 ? (current === 2 ? first : `${baseHref}${current - 1}`) : null;
const derivedNext = current < last ? `${baseHref}${current + 1}` : null;
const prev = prevHref !== undefined ? prevHref : derivedPrev;
const next = nextHref !== undefined ? nextHref : derivedNext;
const pages = Array.from({ length: last }, (_, i) => i + 1);
---

{
	last > 1 && (
		<nav class="pagination" aria-label="分页导航">
			{prev ? (
				<a class="page-nav" href={prev} rel="prev">
					← 上一页
				</a>
			) : (
				<span class="page-nav is-disabled" aria-disabled="true">
					← 上一页
				</span>
			)}

			<ul class="page-nums">
				{pages.map((i) => (
					<li>
						<a
							class={i === current ? 'page-num is-current' : 'page-num'}
							href={pageUrl(i)}
							aria-current={i === current ? 'page' : undefined}
						>
							{i}
						</a>
					</li>
				))}
			</ul>

			{next ? (
				<a class="page-nav" href={next} rel="next">
					下一页 →
				</a>
			) : (
				<span class="page-nav is-disabled" aria-disabled="true">
					下一页 →
				</span>
			)}
		</nav>
	)
}

<style>
	.pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin: 3rem 0 1rem;
	}

	.page-nav {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--primary-color);
		text-decoration: none;
		padding: 0.42rem 0.95rem;
		border-radius: 99em;
		border: 1px solid color-mix(in srgb, var(--primary-color) 28%, transparent);
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}

	.page-nav:hover {
		background: var(--primary-color);
		color: var(--on-accent);
	}

	.page-nav.is-disabled {
		color: var(--text-secondary);
		border-color: var(--border-color);
		opacity: 0.45;
		pointer-events: none;
	}

	.page-nums {
		display: flex;
		gap: 0.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.page-num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.1rem;
		height: 2.1rem;
		padding: 0 0.5rem;
		font-size: 0.9rem;
		font-family: var(--font-mono);
		color: var(--text-secondary);
		text-decoration: none;
		border-radius: 99em;
		border: 1px solid transparent;
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}

	.page-num:hover {
		color: var(--primary-color);
		background: color-mix(in srgb, var(--primary-soft) 40%, transparent);
	}

	.page-num.is-current {
		color: var(--on-accent);
		background: var(--primary-color);
		border-color: var(--primary-color);
		font-weight: 700;
	}
</style>
