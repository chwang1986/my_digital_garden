---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const p of posts) {
	if (p.data.theme) counts.set(p.data.theme, (counts.get(p.data.theme) ?? 0) + 1);
}
const themes = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`主题 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 3.5rem 1.25rem 1rem;
			}
			.page-head {
				margin-bottom: 2.5rem;
			}
			.page-head h1 {
				font-size: 2.6rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				margin: 0 0 0.5rem;
			}
			.page-head p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.15rem;
			}
			.theme-cloud {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
			.theme-cloud a {
				display: inline-flex;
				align-items: baseline;
				gap: 0.4rem;
				text-decoration: none;
				color: var(--primary-color);
				border: 1px solid color-mix(in srgb, var(--primary-color) 30%, transparent);
				border-radius: 99em;
				padding: 0.45rem 0.95rem;
				font-size: 0.95rem;
				transition:
					background 0.2s ease,
					color 0.2s ease;
			}
			.theme-cloud a:hover {
				background: var(--primary-color);
				color: var(--on-accent);
			}
			.theme-cloud .count {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				opacity: 0.7;
			}
			.all-link {
				margin-top: 2.5rem;
				font-size: 0.95rem;
			}
			.all-link a {
				color: var(--primary-color);
				text-decoration: none;
				border-bottom: 1px solid color-mix(in srgb, var(--primary-color) 40%, transparent);
				padding-bottom: 1px;
				transition: border-color 0.2s ease;
			}
			.all-link a:hover {
				border-color: var(--primary-color);
			}
			@media (max-width: 600px) {
				.page-head h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>主题</h1>
				<p>按主题归档，点进去看同一主题下的文章。</p>
			</header>
			{
				themes.length > 0 ? (
					<div class="theme-cloud">
						{themes.map(([c, n]) => (
							<a href={`/themes/${encodeURIComponent(c)}/`}>
								{c}
								<span class="count">{n}</span>
							</a>
						))}
					</div>
				) : (
					<p>还没有主题。</p>
				)
			}
			<p class="all-link">
				<a href="/posts">查看全部文章（标题 · 主题 · 时间 · 标签）→</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
